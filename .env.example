# LLM —— LiteLLM Proxy (OpenAI 兼容)
LLM_BASE_URL=https://llm-proxy.forgeax.com/v1
LLM_API_KEY=sk-your-key-here
# 代理可用模型示例：gpt-5.5 / gemini-3.1-pro / gemini-3.5-flash / deepseek-v4-pro / claude-opus-4-8
LLM_MODEL=gpt-5.5

# 封面生图（Interactive GDD 第一阶段）
# 默认复用上面的 LiteLLM 代理与 Key，走 OpenAI 兼容 POST /images/generations。
# 微信小程序不直连代理：图片由本服务 /api/session/:id/cover 下发。
# IMAGE_BASE_URL=https://llm-proxy.forgeax.com/v1
# IMAGE_API_KEY=sk-your-key-here
IMAGE_MODEL=gpt-image-2
IMAGE_SIZE=1024x1024
# 关掉生图：IMAGE_MODEL=

# forgeax-studio 仓库根（resolver 读取真实目录用，只读）
FORGEAX_ROOT=../forgeax-studio

# server
PORT=8420

# 数据库（Postgres）—— 可选；配置后会话入库 + 启用产出物卡片 API（/api/artifacts）
# 未配置则回退文件存储（data/sessions、data/exports）
# DATABASE_URL=postgres://forgeax:forgeax@localhost:5432/chat_questioner

# 知识库（RAG）—— 可选；未配置则用默认本地模型
KB_EMBEDDING_MODEL=Xenova/bge-small-zh-v1.5
KB_TOP_K=3
