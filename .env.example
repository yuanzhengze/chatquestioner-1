# LLM —— LiteLLM Proxy (OpenAI 兼容)
LLM_BASE_URL=https://llm-proxy.forgeax.com/v1
LLM_API_KEY=sk-your-key-here
# 代理可用模型示例：gemini-3.1-pro / gemini-3.5-flash / deepseek-v4-pro / claude-opus-4-8 / gpt-5.5
LLM_MODEL=gemini-3.1-pro

# forgeax-studio 仓库根（resolver 读取真实目录用，只读）
FORGEAX_ROOT=../forgeax-studio

# server
PORT=8420
