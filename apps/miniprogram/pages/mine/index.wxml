<view class="mine">
  <view class="hero">
    <image class="hero-logo" src="{{logoSrc}}" mode="aspectFit" />
    <view class="hero-name">ForgeaX</view>
    <view class="hero-sub">游戏创意前置共创</view>
  </view>

  <view class="card">
    <view class="login" bindtap="onLogin">
      <view class="login-title">登录</view>
      <view class="login-hint">暂时不用登录也能共创</view>
    </view>
  </view>

  <view class="hist-card">
    <view class="hist-toggle" bindtap="onToggleHist">
      <view class="hist-toggle-title">共创记录</view>
      <view class="hist-chevron {{histOpen ? 'on' : ''}}"></view>
    </view>
    <view class="hist-clip {{histOpen ? 'on' : ''}}" style="height: {{histOpen ? histPanelPx : 0}}px;">
      <view class="hist-reveal">
      <view wx:if="{{historyItems.length === 0}}" id="hist-empty" class="hist-empty">还没有保存的共创。先聊一句就会出现在这里。</view>
      <scroll-view
        wx:else
        scroll-y
        show-scrollbar="{{false}}"
        class="hist-scroll"
        style="height: {{histScrollPx}}px;"
      >
        <view id="hist-measure" class="hist-cards">
          <view
            wx:for="{{historyItems}}"
            wx:key="id"
            class="rec {{pickedId === item.id ? 'on' : ''}}"
            data-id="{{item.id}}"
            bindtap="onPickCard"
          >
            <view class="rec-cover">
              <image wx:if="{{item.coverUrl}}" class="rec-img" src="{{item.coverUrl}}" mode="aspectFill" />
              <image wx:else class="rec-ph" src="{{logoSrc}}" mode="aspectFit" />
            </view>
            <view class="rec-copy">
              <view class="rec-title">{{item.title}}</view>
              <view wx:if="{{item.pitch}}" class="rec-pitch">{{item.pitch}}</view>
              <view wx:elif="{{!item.hasDoc}}" class="rec-pitch muted">还在共创，文档还没生成</view>
            </view>
            <view class="rec-side" catchtap="noop">
              <view class="rec-go" hover-class="rec-press" data-id="{{item.id}}" catchtap="onRecordAction">{{item.action === 'view' ? '查看' : '继续'}}</view>
              <view class="rec-del" data-id="{{item.id}}" catchtap="onDeleteSession">删除</view>
            </view>
          </view>
        </view>
      </scroll-view>
      </view>
    </view>
  </view>

  <view class="list">
    <view class="row" bindtap="onShowLegal" data-kind="terms">
      <view class="row-label">用户协议</view>
      <view class="row-go">></view>
    </view>
    <view class="row" bindtap="onShowLegal" data-kind="privacy">
      <view class="row-label">隐私政策</view>
      <view class="row-go">></view>
    </view>
    <view class="row" bindtap="onOpenAbout">
      <view class="row-label">关于 ForgeaX</view>
      <view class="row-go">></view>
    </view>
    <view class="row" bindtap="onSettings">
      <view class="row-label">设置</view>
      <view class="row-go">></view>
    </view>
  </view>
</view>

<view wx:if="{{showLegal}}" class="mask" catchtap="onCloseSheets">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{legalTitle}}</view>
    <scroll-view scroll-y class="sheet-body">
      <text class="sheet-text">{{legalBody}}</text>
    </scroll-view>
    <button class="btn primary" hover-class="press" bindtap="onCloseSheets">知道了</button>
  </view>
</view>

<view wx:if="{{showAbout}}" class="mask" catchtap="onCloseSheets">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">关于 ForgeaX</view>
    <view class="sheet-body">
      <text class="sheet-text">{{slogan}}</text>
      <view class="url" bindtap="onCopyLink">{{siteUrl}}</view>
    </view>
    <button class="btn primary sheet-btn" hover-class="press" bindtap="onCopyLink">复制开源链接</button>
    <button class="btn ghost sheet-btn" hover-class="press" bindtap="onCloseSheets">关闭</button>
  </view>
</view>
