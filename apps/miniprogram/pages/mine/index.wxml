<view class="mine">
  <view class="topscrim" style="height:{{navTop}}px"></view>

  <view class="hero" style="padding-top:{{navTop}}px">
    <view class="hero-bg">
      <image wx:if="{{!heroFailed}}" class="hero-img" src="{{heroSrc}}" mode="aspectFill" binderror="onHeroError" />
      <view class="hero-shade"></view>
    </view>
    <view class="brand" style="min-height:{{navHeight}}px;margin-right:{{capsuleRight}}px">
      <image class="brand-mark" src="{{logoSrc}}" mode="aspectFit" />
      <view class="brand-copy">
        <image class="brand-word" src="{{wordmarkSrc}}" mode="heightFix" aria-label="ForgeAX" />
        <view class="brand-kicker">游戏创意前置共创</view>
      </view>
    </view>

    <view class="profile">
      <view class="avatar">
        <image class="avatar-logo" src="{{logoSrc}}" mode="aspectFit" />
      </view>
      <view class="profile-copy">
        <view class="profile-name">创意玩家</view>
        <view class="profile-motto">让脑洞，慢慢长成一个世界。</view>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">共创记录</view>
    <view wx:if="{{historyItems.length}}" class="panel">
      <scroll-view
        class="records {{historyItems.length > 2 ? 'capped' : ''}}"
        scroll-y
        enhanced
        bounces="{{false}}"
        show-scrollbar="{{false}}"
      >
        <view
          wx:for="{{historyItems}}"
          wx:key="id"
          class="rec {{index ? 'sep' : ''}}"
          hover-class="press"
          data-id="{{item.id}}"
          bindtap="onOpenRecord"
          bindlongpress="onDeleteSession"
        >
          <view class="rec-cover">
            <image wx:if="{{item.coverUrl}}" class="rec-img" src="{{item.coverUrl}}" mode="aspectFill" />
            <image wx:else class="rec-ph" src="{{logoSrc}}" mode="aspectFit" />
          </view>
          <view class="rec-copy">
            <view class="rec-title">{{item.title}}</view>
            <view wx:if="{{item.pitch}}" class="rec-pitch">{{item.pitch}}</view>
            <view wx:elif="{{!item.hasDoc}}" class="rec-pitch muted">还在共创，文档还没生成</view>
          </view>
          <image class="rec-arrow" src="/images/home/icon-arrow-light.png" />
        </view>
      </scroll-view>
    </view>
    <view wx:else class="panel empty">
      <view class="empty-title">还没有共创记录</view>
      <view class="empty-hint">从一个脑洞开始吧</view>
      <view class="empty-cta" hover-class="press" aria-role="button" bindtap="onStartCocreate">
        <text>开始共创</text>
        <image class="empty-arrow" src="/images/home/icon-arrow-light.png" />
      </view>
    </view>
  </view>

  <view class="section">
    <view class="panel">
      <view class="row" hover-class="press" data-kind="terms" bindtap="onShowLegal">
        <image class="row-icon" src="/images/mine/icon-terms.png" />
        <view class="row-label">用户协议</view>
        <image class="row-arrow" src="/images/home/icon-arrow-light.png" />
      </view>
      <view class="row sep" hover-class="press" data-kind="privacy" bindtap="onShowLegal">
        <image class="row-icon" src="/images/mine/icon-privacy.png" />
        <view class="row-label">隐私政策</view>
        <image class="row-arrow" src="/images/home/icon-arrow-light.png" />
      </view>
      <view class="row sep" hover-class="press" bindtap="onOpenAbout">
        <image class="row-icon" src="/images/mine/icon-about.png" />
        <view class="row-label">关于 ForgeaX</view>
        <image class="row-arrow" src="/images/home/icon-arrow-light.png" />
      </view>
      <view class="row sep" hover-class="press" bindtap="onSettings">
        <image class="row-icon" src="/images/mine/icon-settings.png" />
        <view class="row-label">设置</view>
        <image class="row-arrow" src="/images/home/icon-arrow-light.png" />
      </view>
    </view>
  </view>
</view>

<view wx:if="{{showLegal}}" class="mask {{sheetIn ? 'in' : ''}}" catchtap="onCloseSheets">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{legalTitle}}</view>
    <scroll-view scroll-y class="sheet-body">
      <text class="sheet-text">{{legalBody}}</text>
    </scroll-view>
    <button class="btn primary" hover-class="press" bindtap="onCloseSheets">知道了</button>
  </view>
</view>

<view wx:if="{{showAbout}}" class="mask {{sheetIn ? 'in' : ''}}" catchtap="onCloseSheets">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">关于 ForgeaX</view>
    <view class="sheet-body">
      <text class="sheet-text">{{slogan}}</text>
      <view class="url" bindtap="onCopyLink">{{siteUrl}}</view>
    </view>
    <button class="btn primary sheet-btn" hover-class="press" bindtap="onCopyLink">复制开源链接</button>
    <button class="btn ghost sheet-btn" hover-class="press" bindtap="onCloseSheets">关闭</button>
  </view>
</view>
