page { background: var(--bg-canvas); color: var(--text); }

.mine {
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 32rpx;
}
.hero-logo {
  width: 120rpx;
  height: 120rpx;
}
.hero-name {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.hero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.card {
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
  padding: 28rpx;
}
.login-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.login-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.hist-card {
  margin-top: 24rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
  overflow: hidden;
}
.hist-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
}
.hist-toggle-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.hist-chevron {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--text-3);
  border-bottom: 3rpx solid var(--text-3);
  transform: rotate(45deg);
  transition: transform var(--dur-panel) var(--ease-out);
}
.hist-chevron.on {
  transform: rotate(225deg);
  border-color: var(--brand);
}
.hist-body {
  border-top: 1px solid var(--divider);
}
.hist-empty {
  padding: 20rpx 28rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-2);
}
.hist-list {
  box-sizing: border-box;
}
.hist-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 16rpx 20rpx 28rpx;
  border-bottom: 1px solid var(--divider);
}
.hist-item:last-child { border-bottom: none; }
.hist-item.on {
  background: var(--brand-tint);
  border-left: 3px solid var(--brand);
  padding-left: 22rpx;
}
.hist-main {
  flex: 1;
  min-width: 0;
}
.hist-title {
  font-size: 28rpx;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hist-item.on .hist-title { color: var(--brand); }
.hist-del {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: var(--error);
}

.list {
  margin-top: 36rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1px solid var(--divider);
}
.row:last-child { border-bottom: none; }
.row-label {
  font-size: 28rpx;
  color: var(--text);
}
.row-go {
  font-size: 28rpx;
  color: var(--text-3);
}

.mask {
  position: fixed;
  inset: 0;
  background: var(--overlay);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 28rpx 32rpx 40rpx;
  background: var(--bg-base);
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1px solid var(--border-subtle);
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}
.sheet-body {
  max-height: 42vh;
  margin-bottom: 20rpx;
}
.sheet-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
  white-space: pre-wrap;
}
.url {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  font-size: 22rpx;
  color: var(--text-link);
  word-break: break-all;
}
.btn {
  margin: 0;
  padding: 0;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--r-full);
  font-size: 28rpx;
  font-weight: 500;
}
.btn::after { border: none; }
.btn.primary {
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
}
.btn.ghost {
  background: var(--action-secondary-bg);
  color: var(--action-secondary-fg);
  border: 1px solid var(--border);
}
.press { transform: scale(var(--press-scale)); }
.btn.primary.press {
  background: var(--action-primary-pressed) !important;
  color: var(--action-primary-fg) !important;
}
.btn.ghost.press {
  background: var(--action-secondary-hover) !important;
  color: var(--text) !important;
  border-color: var(--border) !important;
}
.sheet-btn { margin-top: 12rpx; }
