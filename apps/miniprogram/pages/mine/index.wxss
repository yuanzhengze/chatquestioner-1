page { background: #0d0d0d; color: #ffffff; }

.mine {
  box-sizing: border-box;
  padding: 24rpx 32rpx 48rpx;
}

.hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 24rpx 0 32rpx;
}
.hero-logo {
  width: 120rpx;
  height: 120rpx;
}
.hero-name {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}
.hero-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.30);
}

.card {
  background: #191919;
  border: 1px solid #333333;
  border-radius: 24rpx;
  padding: 28rpx;
}
.login-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}
.login-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.30);
}

.hist-card {
  margin-top: 24rpx;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 24rpx;
  overflow: hidden;
}
.hist-toggle {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 28rpx;
}
.hist-toggle-title {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 600;
  color: #ffffff;
}
.hist-chevron {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid rgba(255, 255, 255, 0.30);
  border-bottom: 3rpx solid rgba(255, 255, 255, 0.30);
  transform: rotate(45deg);
  transition: transform 0.22s ease;
}
.hist-chevron.on {
  transform: rotate(225deg);
  border-color: #d4ff48;
}
.hist-body {
  border-top: 1px solid rgba(255, 255, 255, 0.10);
}
.hist-empty {
  padding: 20rpx 28rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.60);
}
.hist-list {
  box-sizing: border-box;
}
.hist-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 16rpx 20rpx 28rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
.hist-item:last-child { border-bottom: none; }
.hist-item.on {
  background: rgba(212, 255, 72, 0.10);
  border-left: 3px solid #d4ff48;
  padding-left: 22rpx;
}
.hist-main {
  flex: 1;
  min-width: 0;
}
.hist-title {
  font-size: 28rpx;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hist-item.on .hist-title { color: #d4ff48; }
.hist-del {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #f26a6a;
}

.list {
  margin-top: 36rpx;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 24rpx;
  overflow: hidden;
}
.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
.row:last-child { border-bottom: none; }
.row-label {
  font-size: 28rpx;
  color: #ffffff;
}
.row-go {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.30);
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 28rpx 32rpx 40rpx;
  background: #191919;
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1px solid #333333;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}
.sheet-body {
  max-height: 42vh;
  margin-bottom: 20rpx;
}
.sheet-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.60);
  white-space: pre-wrap;
}
.url {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #242424;
  border: 1px solid #333333;
  font-size: 22rpx;
  color: #d4ff48;
  word-break: break-all;
}
.btn {
  margin: 0;
  padding: 0;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn::after { border: none; }
.btn.primary {
  background: #d4ff48;
  color: #0d0d0d;
}
.btn.ghost {
  background: #191919;
  color: #ffffff;
  border: 1px solid #404040;
}
.press {
  background: #c5ee3a !important;
  color: #0d0d0d !important;
}
.sheet-btn { margin-top: 12rpx; }
