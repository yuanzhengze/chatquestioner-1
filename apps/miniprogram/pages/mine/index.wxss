page { background: var(--bg-canvas); color: var(--text); }

/* 品牌区、头像区、记录、功能区共用一条左右内容线（与首页一致）；背景照常铺满 */
.mine {
  --page-inset: 40rpx;
  position: relative;
  box-sizing: border-box;
  padding-bottom: 48rpx;
}

/* 顶部氛围图：铺满品牌区和头像区，再往下延伸到「我的共创记录」标题，在那里渐隐成页面底色 */
.hero-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: -72rpx;
  overflow: hidden;
}
.hero-img {
  display: block;
  width: 100%;
  height: 100%;
}
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(180deg, rgba(26, 28, 31, 0.55) 0%, rgba(26, 28, 31, 0) 28%, rgba(26, 28, 31, 0) 52%, rgba(26, 28, 31, 0.82) 84%, #1A1C1F 100%),
    linear-gradient(90deg, rgba(26, 28, 31, 0.55) 0%, rgba(26, 28, 31, 0) 62%);
}

/* 滚动后让状态栏的时间、电量始终压在深色上 */
.topscrim {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(26, 28, 31, 0.85) 0%, rgba(26, 28, 31, 0) 100%);
}

.hero {
  position: relative;
  z-index: 1;
  padding: 0 var(--page-inset) 32rpx;
}

.brand {
  position: relative;
  display: flex;
  align-items: center;
}
.brand-mark {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
}
.brand-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}
.brand-word {
  height: 34rpx;
}
.brand-kicker {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 0.12em;
  color: var(--text-2);
}

.profile {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 120rpx;
}
.avatar {
  width: 128rpx;
  height: 128rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: 50%;
  background: var(--bg-elevated);
  border: 1px solid rgba(237, 237, 237, 0.16);
}
.avatar-logo {
  width: 64rpx;
  height: 64rpx;
}
.profile-copy {
  flex: 1;
  min-width: 0;
  margin-left: 28rpx;
}
.profile-name {
  font-size: 40rpx;
  font-weight: 700;
  line-height: 1.3;
  color: var(--text);
  text-shadow: 0 2rpx 16rpx rgba(0, 0, 0, 0.35);
}
.profile-motto {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
}

.section {
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  padding: 0 var(--page-inset);
}
.section-title {
  margin-bottom: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}

/* 记录和功能区都是一整块面，行与行之间只用细分隔线 */
.panel {
  overflow: hidden;
  border-radius: 24rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
}

/* 记录超过 2 条时框内滚动：上限约 3.3 行（单行 184rpx = 封面 136 + 上下 24），露出一截提示还能滚；矮屏再按 50vh 收 */
.records {
  width: 100%;
}
.records.capped {
  height: 600rpx;
  max-height: 50vh;
}
.rec {
  display: flex;
  align-items: center;
  box-sizing: border-box;
  min-height: 184rpx;
  padding: 24rpx;
}
.rec.sep,
.row.sep {
  border-top: 1px solid var(--divider-subtle);
}
.rec.press,
.row.press {
  background: var(--hover);
}
.rec-cover {
  width: 136rpx;
  height: 136rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border-radius: 16rpx;
  background: var(--bg-elevated);
}
.rec-img { width: 100%; height: 100%; }
.rec-ph { width: 56rpx; height: 56rpx; }
.rec-copy {
  flex: 1;
  min-width: 0;
  margin: 0 16rpx 0 24rpx;
}
.rec-title {
  display: -webkit-box;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text);
}
.rec-pitch {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
}
.rec-pitch.muted { color: var(--text-3); }
.rec-arrow,
.row-arrow,
.empty-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.6;
}

.empty {
  padding: 40rpx 32rpx;
}
.empty-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.empty-hint {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: var(--text-3);
}
.empty-cta {
  display: inline-flex;
  align-items: center;
  height: 72rpx;
  margin-top: 28rpx;
  padding: 0 20rpx 0 32rpx;
  box-sizing: border-box;
  border-radius: var(--r-full);
  border: 1px solid rgba(237, 237, 237, 0.24);
  font-size: 26rpx;
  color: var(--text);
}
.empty-cta .empty-arrow {
  margin-left: 12rpx;
}
.empty-cta.press {
  background: var(--action-secondary-hover);
}

.row {
  display: flex;
  align-items: center;
  min-height: 104rpx;
  padding: 0 24rpx 0 28rpx;
}
.row-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.row-label {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  font-size: 28rpx;
  color: var(--text);
}

/* 抽屉：遮罩淡入 + 抽屉自底部滑入，关闭时同步反向；时长与 SHEET_MS 一致 */
.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  z-index: 20;
  background: var(--overlay);
  opacity: 0;
  transition: opacity var(--dur-panel) var(--ease-out);
}
.mask.in {
  opacity: 1;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 28rpx 32rpx 40rpx;
  background: var(--bg-base);
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1px solid var(--border-subtle);
  transform: translateY(100%);
  transition: transform var(--dur-panel) var(--ease-out);
}
.mask.in .sheet {
  transform: translateY(0);
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}
.sheet-body {
  max-height: 42vh;
  margin-bottom: 20rpx;
}
.sheet-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
  white-space: pre-wrap;
}
.url {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  font-size: 22rpx;
  color: var(--text-link);
  word-break: break-all;
}
.btn {
  margin: 0;
  padding: 0;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--r-full);
  font-size: 28rpx;
  font-weight: 500;
}
.btn::after { border: none; }
.btn.primary {
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
}
.btn.ghost {
  background: var(--action-secondary-bg);
  color: var(--action-secondary-fg);
  border: 1px solid var(--border);
}
.btn.primary.press {
  background: var(--action-primary-pressed) !important;
  color: var(--action-primary-fg) !important;
}
.btn.ghost.press {
  background: var(--action-secondary-hover) !important;
  color: var(--text) !important;
  border-color: var(--border) !important;
}
.sheet-btn { margin-top: 12rpx; }
