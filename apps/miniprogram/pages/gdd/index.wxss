page { background: #0d0d0d; color: #ffffff; }

.loading {
  padding: 160rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.loading-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #333333;
  border-top-color: #d4ff48;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

.wrap {
  box-sizing: border-box;
  padding: 24rpx 32rpx 64rpx;
}

.cover {
  position: relative;
  min-height: 360rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 32rpx;
  background: #191919;
  color: #ffffff;
  border: 1px solid #333333;
  border-top: 4px solid #d4ff48;
}

.cover-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.cover-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: rgba(212, 255, 72, 0.10);
  border: 1px solid #d4ff48;
  color: #d4ff48;
  font-size: 20rpx;
}
.cover-logo {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.cover-title {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  color: #ffffff;
}

.cover-pitch {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.60);
}

.cover-brand {
  margin-top: 36rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: #d4ff48;
}

.share-banner {
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(212, 255, 72, 0.10);
  border: 1px solid #333333;
  color: #d4ff48;
  font-size: 22rpx;
  text-align: center;
}

.share-btn {
  margin: 28rpx 0 0;
  padding: 0;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #d4ff48;
  color: #0d0d0d;
}
.share-btn::after { border: none; }

.share-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 500px;
  height: 400px;
  transform: translateX(-120%);
  pointer-events: none;
}

.share-footer { margin-top: 40rpx; }

.try-btn {
  margin: 40rpx auto 0;
  padding: 0;
  width: 70%;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #d4ff48;
  color: #0d0d0d;
}
.try-btn::after { border: none; }
.try-btn.ghost {
  background: #191919;
  color: #ffffff;
  border: 1px solid #404040;
}

.block {
  margin-top: 36rpx;
  padding: 28rpx;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 24rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}

.plan-col + .plan-col { margin-top: 24rpx; }

.plan-h {
  font-size: 22rpx;
  font-weight: 600;
  color: #d4ff48;
  margin-bottom: 8rpx;
}

.plan-h.cut { color: rgba(255, 255, 255, 0.30); }

.plan-item {
  font-size: 26rpx;
  line-height: 1.55;
  color: #ffffff;
  padding: 8rpx 0;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}

.muted {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.60);
  line-height: 1.55;
}

.doc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.doc-head .label { margin-bottom: 0; }

.copy {
  font-size: 22rpx;
  line-height: 1;
  color: #d4ff48;
  padding: 0 16rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border: 1px solid #d4ff48;
  border-radius: 16rpx;
}

.doc-plain {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: #ffffff;
  white-space: pre-wrap;
}

.empty {
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty-logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  display: block;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}
