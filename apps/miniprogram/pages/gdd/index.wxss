page { background: var(--bg-canvas); color: var(--text); }

.loading {
  padding: 160rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.loading-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--border-subtle);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

.wrap {
  box-sizing: border-box;
  padding: 24rpx 32rpx 64rpx;
}

.cover {
  position: relative;
  height: 560rpx;
  border-radius: 32rpx;
  background: var(--bg-base);
  color: var(--text);
  border: 1px solid var(--border-subtle);
  border-top: 4px solid var(--brand);
  overflow: hidden;
}

.cover-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}
.regen {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-tint);
  border: 1px solid var(--brand-stroke);
  color: var(--brand);
  font-size: 24rpx;
}
.regen.off {
  opacity: 0.4;
  border-color: var(--neutral-600);
  color: var(--text-3);
}

.cover-img {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.cover-shade {
  position: relative;
  z-index: 1;
  height: 560rpx;
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(180deg, rgba(26, 28, 31, 0.12) 0%, rgba(26, 28, 31, 0.55) 48%, rgba(26, 28, 31, 0.88) 100%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cover-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.cover-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: var(--brand-tint);
  border: 1px solid var(--brand);
  color: var(--brand);
  font-size: 20rpx;
}
.cover-mark {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-left: auto;
  flex-shrink: 0;
}
.cover-logo {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}
.cover-mark-name {
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  letter-spacing: 0.04em;
  color: var(--text-2);
}

.cover-title {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text);
}

.cover-pitch {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-2);
}


.share-banner {
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: var(--brand-tint);
  border: 1px solid var(--border-subtle);
  color: var(--brand);
  font-size: 22rpx;
  text-align: center;
}

.share-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 28rpx 0 0;
}

.share-btn,
.export-btn {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  border-radius: var(--r-full);
  font-size: 30rpx;
  font-weight: 500;
}

.share-btn {
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
}
.share-btn::after,
.export-btn::after,
.try-btn::after { border: none; }
.share-btn.press,
.try-btn.press {
  background: var(--action-primary-pressed) !important;
  color: var(--action-primary-fg) !important;
  transform: scale(var(--press-scale));
}
.export-btn.press,
.try-btn.ghost.press {
  background: var(--action-secondary-hover) !important;
  color: var(--text) !important;
  transform: scale(var(--press-scale));
}

.export-btn {
  background: var(--action-secondary-bg);
  color: var(--action-secondary-fg);
  border: 1px solid var(--border);
}

.share-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 500px;
  height: 400px;
  transform: translateX(-120%);
  pointer-events: none;
}

.share-footer { margin-top: 40rpx; }

.try-btn {
  margin: 40rpx auto 0;
  padding: 0;
  width: 70%;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  border-radius: var(--r-full);
  font-size: 30rpx;
  font-weight: 500;
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
}
.try-btn.ghost {
  background: var(--action-secondary-bg);
  color: var(--action-secondary-fg);
  border: 1px solid var(--border);
}

.draft-bar {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--brand-tint);
  border: 1px solid var(--brand);
  color: var(--brand);
  font-size: 24rpx;
  line-height: 1.5;
}

.card {
  margin-top: 20rpx;
  padding-top: 24rpx;
  padding-bottom: 24rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
}
.card.on {
  border-color: var(--border);
}
.card-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.card-chevron {
  color: var(--brand);
  font-size: 28rpx;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform var(--dur-smooth) var(--ease-out);
}
.card.on .card-chevron {
  transform: rotate(90deg);
}
.card-fold {
  display: grid;
  grid-template-rows: 0fr;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: grid-template-rows var(--dur-smooth) var(--ease-out), max-height var(--dur-smooth) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}
.card.on .card-fold {
  grid-template-rows: 1fr;
  max-height: 4000rpx;
  opacity: 1;
}
.card-body {
  min-height: 0;
  overflow: hidden;
  margin-top: 0;
}
.card.on .card-body {
  margin-top: 16rpx;
}
.card-line {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-2);
  padding: 16rpx 8rpx;
  border: 1px solid transparent;
  border-bottom-color: var(--divider-subtle);
  border-radius: 12rpx;
  background: transparent;
  transition: border-color var(--dur-smooth) var(--ease-out);
}
.card-line.tap:active {
  opacity: 0.82;
}
.card-line.on {
  border-color: var(--brand);
  background: transparent;
  color: var(--text-2);
}
.card-line-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-2);
}
.line-actions {
  display: grid;
  grid-template-rows: 0fr;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition:
    grid-template-rows var(--dur-smooth) var(--ease-out),
    max-height var(--dur-smooth) var(--ease-out),
    opacity var(--dur-smooth) var(--ease-out);
}
.line-actions.on {
  grid-template-rows: 1fr;
  max-height: 96rpx;
  opacity: 1;
}
.line-actions-inner {
  min-height: 0;
  overflow: hidden;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 4rpx 8rpx 12rpx;
}
.line-act {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1px solid var(--border);
  background: transparent;
  color: var(--text-2);
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.4;
}
.line-act.primary {
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
  border-color: transparent;
}
.line-act-press { opacity: 0.72; }

.patch-hint {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.block {
  margin-top: 36rpx;
  padding-top: 28rpx;
  padding-bottom: 28rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
}
.block,
.card {
  padding-left: 28rpx;
  padding-right: 28rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.plan-col + .plan-col { margin-top: 24rpx; }

.plan-h {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 8rpx;
}

.plan-h.cut { color: var(--text-3); }

.plan-item {
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text);
  padding: 8rpx 0;
  border-bottom: 1px solid var(--divider);
}

.muted {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.55;
}

.doc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.doc-head .label { margin-bottom: 0; }

.copy {
  font-size: 22rpx;
  line-height: 1;
  color: var(--brand);
  padding: 0 16rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--brand-tint);
  border: 1px solid var(--brand-stroke);
  border-radius: 12rpx;
}

.doc-name {
  margin: 0 0 12px;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.4;
  color: #EDEDED;
}
.doc-pitch {
  margin: 8px 0 0;
  padding: 8px 12px;
  background: #222326;
  border-left: 3px solid #C5DD78;
  border-radius: 12px;
  font-size: 14px;
  line-height: 1.65;
  color: #EDEDED;
}
.doc-toggle {
  margin-top: 8px;
  padding: 14px 24px;
  text-align: center;
  font-size: 12px;
  line-height: 1.4;
  color: var(--text-3);
  background: transparent;
}
.doc-toggle-press { opacity: 0.55; }
.doc-block {
  position: relative;
  padding-bottom: 4px;
}
.doc-fold {
  position: relative;
  overflow: hidden;
  opacity: 0;
  transition: height 220ms var(--ease-out), opacity 220ms var(--ease-out);
}
.doc-fold.on {
  opacity: 1;
}
.doc-fold.measure {
  position: absolute;
  left: 0;
  right: 0;
  height: auto !important;
  opacity: 0;
  overflow: visible;
  pointer-events: none;
  transition: none;
}
.doc-fold.snap {
  transition: none;
}
.doc-fold.settled {
  height: auto !important;
  overflow: visible;
}
.doc-fold-inner {
  width: 100%;
}
.doc-fold:not(.on) .doc-fold-inner {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
}
.doc-fold.measure .doc-fold-inner {
  position: static;
}
.doc-plain {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--text);
  white-space: pre-wrap;
}

.empty {
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty-logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  display: block;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.profile {
  margin-top: 36rpx;
  padding-left: 28rpx;
  padding-right: 28rpx;
}
.profile-title { margin-bottom: 14rpx; }
.profile-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 10rpx;
}
.profile-genres { margin-bottom: 12rpx; }
.chip {
  max-width: 100%;
  font-size: 22rpx;
  font-weight: 400;
  line-height: 1.3;
  color: var(--text-2);
  padding: 6rpx 14rpx;
  border: 1px solid var(--border-subtle);
  border-radius: 999rpx;
}
.chip.genre {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  border-color: var(--brand);
}
.profile-format {
  margin-top: 18rpx;
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text-3);
}

.moments {
  box-sizing: border-box;
  margin-top: 48rpx;
  margin-bottom: 12rpx;
  margin-left: -32rpx;
  margin-right: -32rpx;
  width: calc(100% + 64rpx);
}
.moments-heading {
  padding-left: 60rpx;
  padding-right: 32rpx;
}
.moments-row {
  width: 100%;
  margin-top: 16rpx;
  white-space: nowrap;
}
.moments-lead,
.moments-tail {
  display: inline-block;
  width: 32rpx;
  height: 1px;
}
.moment {
  display: inline-block;
  vertical-align: top;
  width: 600rpx;
  margin-right: 20rpx;
  white-space: normal;
}
.moment-shot {
  position: relative;
  width: 100%;
  height: 0;
  padding-top: 56.25%;
  background: var(--bg-inset);
  border: 1px solid var(--border-subtle);
  border-radius: var(--r-panel);
  overflow: hidden;
}
.moment-photo,
.moment-state {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  width: 100%;
  height: 100%;
}
.moment-state {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 22rpx;
  color: var(--text-3);
}
.moment-flag {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--bg-canvas);
  color: var(--text-3);
  font-size: 20rpx;
  line-height: 1.4;
}
.moment-redo {
  position: absolute;
  right: 16rpx;
  bottom: 16rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: var(--bg-canvas);
  color: var(--text-2);
  font-size: 20rpx;
  line-height: 1.4;
}
.moment-caption {
  margin-top: 16rpx;
  margin-left: 28rpx;
  margin-right: 28rpx;
}
.moment-desc {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
  white-space: normal;
}
