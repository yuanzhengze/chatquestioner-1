page { background: #FAF8F4; }

.wrap {
  box-sizing: border-box;
  padding: 24rpx 32rpx 64rpx;
}

.cover {
  position: relative;
  min-height: 360rpx;
  padding: 36rpx 32rpx 28rpx;
  border-radius: 24rpx;
  background:
    radial-gradient(80% 80% at 80% 0%, rgba(255, 201, 77, 0.45) 0%, transparent 55%),
    linear-gradient(160deg, #E8943A 0%, #C56A12 70%);
  color: #fff;
  box-shadow: 0 12rpx 40rpx rgba(197, 106, 18, 0.28);
}

.cover-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.2);
  font-size: 20rpx;
}

.cover-title {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 700;
  line-height: 1.3;
}

.cover-pitch {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
  opacity: 0.92;
}

.cover-brand {
  margin-top: 36rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  opacity: 0.8;
}

.block {
  margin-top: 36rpx;
  padding: 28rpx;
  background: #fff;
  border: 1px solid #ECE6DC;
  border-radius: 20rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 700;
  color: #3A3530;
  margin-bottom: 16rpx;
}

.plan-col + .plan-col { margin-top: 24rpx; }

.plan-h {
  font-size: 22rpx;
  font-weight: 600;
  color: #5B8A8A;
  margin-bottom: 8rpx;
}

.plan-h.cut { color: #C77B6B; }

.plan-item {
  font-size: 26rpx;
  line-height: 1.55;
  color: #3A3530;
  padding: 8rpx 0;
  border-bottom: 1px solid #F3EDE3;
}

.muted {
  font-size: 24rpx;
  color: #8A8175;
  line-height: 1.55;
}

.doc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.doc-head .label { margin-bottom: 0; }

.copy {
  font-size: 22rpx;
  color: #E8943A;
  padding: 6rpx 16rpx;
  border: 1px solid #E8943A;
  border-radius: 999px;
}

.doc-plain {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: #3A3530;
  white-space: pre-wrap;
}

.empty {
  padding: 120rpx 48rpx;
  text-align: center;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A3530;
  margin-bottom: 16rpx;
}
