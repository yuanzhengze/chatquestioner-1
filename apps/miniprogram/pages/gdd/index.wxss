page { background: var(--bg-canvas); color: var(--text); }

.loading {
  padding: 160rpx 48rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.loading-logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 20rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--border-subtle);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

.wrap {
  box-sizing: border-box;
  padding: 24rpx 32rpx 64rpx;
}

.cover {
  position: relative;
  height: 560rpx;
  border-radius: 32rpx;
  background: var(--bg-base);
  color: var(--text);
  border: 1px solid var(--border-subtle);
  border-top: 4px solid var(--brand);
  overflow: hidden;
}

.cover-actions {
  margin-top: 16rpx;
  display: flex;
  justify-content: flex-end;
}
.regen {
  padding: 12rpx 24rpx;
  border-radius: 999rpx;
  background: var(--brand-tint);
  border: 1px solid var(--brand-stroke);
  color: var(--brand);
  font-size: 24rpx;
}
.regen.off {
  opacity: 0.4;
  border-color: var(--neutral-600);
  color: var(--text-3);
}

.cover-img {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 0;
  width: 100%;
  height: 100%;
}

.cover-shade {
  position: relative;
  z-index: 1;
  height: 560rpx;
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(180deg, rgba(26, 28, 31, 0.12) 0%, rgba(26, 28, 31, 0.55) 48%, rgba(26, 28, 31, 0.88) 100%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.cover-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.cover-badge {
  display: inline-block;
  padding: 6rpx 16rpx;
  border-radius: 8rpx;
  background: var(--brand-tint);
  border: 1px solid var(--brand);
  color: var(--brand);
  font-size: 20rpx;
}
.cover-logo {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.cover-title {
  margin-top: 28rpx;
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text);
}

.cover-pitch {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-2);
}

.cover-brand {
  margin-top: 36rpx;
  font-size: 22rpx;
  letter-spacing: 0.06em;
  color: var(--brand);
}

.share-banner {
  margin-bottom: 20rpx;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  background: var(--brand-tint);
  border: 1px solid var(--border-subtle);
  color: var(--brand);
  font-size: 22rpx;
  text-align: center;
}

.share-actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin: 28rpx 0 0;
}

.share-btn,
.export-btn {
  margin: 0;
  padding: 0;
  width: 100%;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  border-radius: var(--r-full);
  font-size: 30rpx;
  font-weight: 500;
}

.share-btn {
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
}
.share-btn::after,
.export-btn::after,
.try-btn::after { border: none; }
.share-btn.press,
.try-btn.press {
  background: var(--action-primary-pressed) !important;
  color: var(--action-primary-fg) !important;
  transform: scale(var(--press-scale));
}
.export-btn.press,
.try-btn.ghost.press {
  background: var(--action-secondary-hover) !important;
  color: var(--text) !important;
  transform: scale(var(--press-scale));
}

.export-btn {
  background: var(--action-secondary-bg);
  color: var(--action-secondary-fg);
  border: 1px solid var(--border);
}

.share-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 500px;
  height: 400px;
  transform: translateX(-120%);
  pointer-events: none;
}

.share-footer { margin-top: 40rpx; }

.try-btn {
  margin: 40rpx auto 0;
  padding: 0;
  width: 70%;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  border-radius: var(--r-full);
  font-size: 30rpx;
  font-weight: 500;
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
}
.try-btn.ghost {
  background: var(--action-secondary-bg);
  color: var(--action-secondary-fg);
  border: 1px solid var(--border);
}

.draft-bar {
  margin-top: 20rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--brand-tint);
  border: 1px solid var(--brand);
  color: var(--brand);
  font-size: 24rpx;
  line-height: 1.5;
}

.card {
  margin-top: 20rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
}
.card.on {
  border-color: var(--border);
}
.card-h {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.card-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.card-chevron {
  color: var(--brand);
  font-size: 28rpx;
  line-height: 1;
  transform: rotate(0deg);
  transition: transform var(--dur-smooth) var(--ease-out);
}
.card.on .card-chevron {
  transform: rotate(90deg);
}
.card-fold {
  display: grid;
  grid-template-rows: 0fr;
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transition: grid-template-rows var(--dur-smooth) var(--ease-out), max-height var(--dur-smooth) var(--ease-out), opacity var(--dur-fast) var(--ease-out);
}
.card.on .card-fold {
  grid-template-rows: 1fr;
  max-height: 4000rpx;
  opacity: 1;
}
.card-body {
  min-height: 0;
  overflow: hidden;
  margin-top: 0;
}
.card.on .card-body {
  margin-top: 16rpx;
}
.card-line {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  font-size: 26rpx;
  line-height: 1.6;
  color: var(--text-2);
  padding: 16rpx 8rpx;
  border-bottom: 1px solid var(--divider-subtle);
}
.card-line.tap:active {
  color: var(--brand);
}
.card-line.on {
  background: var(--brand-tint);
  border-radius: 12rpx;
  color: var(--text);
}
.card-line-text {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  line-height: 1.6;
}
.line-edit,
.line-edit-slot {
  flex-shrink: 0;
  width: 32rpx;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: right;
}
.line-edit {
  color: var(--brand);
}
.card-line:last-child { border-bottom: none; }

.patch-hint {
  margin-top: 28rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.block {
  margin-top: 36rpx;
  padding: 28rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
}

.label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.plan-col + .plan-col { margin-top: 24rpx; }

.plan-h {
  font-size: 22rpx;
  font-weight: 600;
  color: var(--brand);
  margin-bottom: 8rpx;
}

.plan-h.cut { color: var(--text-3); }

.plan-item {
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text);
  padding: 8rpx 0;
  border-bottom: 1px solid var(--divider);
}

.muted {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.55;
}

.doc-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.doc-head .label { margin-bottom: 0; }

.copy {
  font-size: 22rpx;
  line-height: 1;
  color: var(--brand);
  padding: 0 16rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  background: var(--brand-tint);
  border: 1px solid var(--brand-stroke);
  border-radius: 12rpx;
}

.doc-plain {
  display: block;
  font-size: 26rpx;
  line-height: 1.65;
  color: var(--text);
  white-space: pre-wrap;
}

.empty {
  padding: 120rpx 48rpx;
  text-align: center;
}
.empty-logo {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 24rpx;
  display: block;
}

.empty-title {
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}

.dna-block { padding-bottom: 8rpx; }

.dna-row {
  white-space: nowrap;
  width: 100%;
}

.dna-chip {
  display: inline-flex;
  flex-direction: column;
  min-width: 200rpx;
  max-width: 280rpx;
  margin-right: 16rpx;
  padding: 16rpx 20rpx;
  border-radius: 16rpx;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  vertical-align: top;
}
.dna-chip.on { border-color: var(--brand); }

.dna-kicker {
  font-size: 20rpx;
  color: var(--brand);
  margin-bottom: 8rpx;
}
.dna-short {
  font-size: 24rpx;
  line-height: 1.4;
  color: var(--text);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.dna-full {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-2);
}

.frame {
  padding: 8rpx 0 0;
}
.frame-kicker {
  font-size: 22rpx;
  color: var(--brand);
  margin-bottom: 8rpx;
}
.frame-text {
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.45;
  color: var(--text);
  min-height: 88rpx;
}
.frame-nav {
  margin-top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.frame-dots { display: flex; gap: 12rpx; }
.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: var(--border);
}
.dot.on { background: var(--brand); }
.next {
  font-size: 24rpx;
  color: var(--text-on-bright);
  background: var(--brand);
  padding: 10rpx 22rpx;
  border-radius: 999rpx;
}

.rings {
  display: flex;
  gap: 16rpx;
}
.ring {
  flex: 1;
  text-align: center;
  padding: 22rpx 8rpx;
  border-radius: 999rpx;
  border: 2px solid var(--border-subtle);
  font-size: 24rpx;
  color: var(--text-2);
}
.ring.on {
  border-color: var(--brand);
  color: var(--brand);
}
.loop-text {
  margin-top: 16rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-2);
}
