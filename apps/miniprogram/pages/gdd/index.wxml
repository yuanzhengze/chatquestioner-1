<view wx:if="{{!ready}}" class="loading">
  <image class="loading-logo" src="{{logoSrc}}" mode="aspectFit" />
  <view class="spinner"></view>
  <view class="muted">正在打开文档…</view>
</view>

<view wx:if="{{ready && empty}}" class="empty">
  <image class="empty-logo" src="{{logoSrc}}" mode="aspectFit" />
  <view class="empty-title">{{fromShare ? '找不到这份分享' : '还没有文档'}}</view>
  <view class="muted">{{fromShare ? '链接可能已失效。你可以自己开一轮共创。' : '回到聊天里再聊几轮，出现「打开预览」后再进来。'}}</view>
  <button wx:if="{{fromShare}}" class="try-btn" hover-class="none" bindtap="onTryCoCreate">我也来共创</button>
</view>

<view wx:if="{{ready && !empty}}" class="wrap">
  <view wx:if="{{fromShare}}" class="share-banner">来自分享的游戏文档</view>
  <view class="cover" bindtap="onCoverTap">
    <view class="cover-top">
      <view class="cover-badge">封面位 · 点按看说明</view>
      <image class="cover-logo" src="{{logoSrc}}" mode="aspectFit" />
    </view>
    <view class="cover-title">{{title}}</view>
    <view wx:if="{{pitch}}" class="cover-pitch">{{pitch}}</view>
    <view class="cover-brand">NewBee × ForgeaX</view>
  </view>

  <button wx:if="{{!fromShare}}" class="share-btn" open-type="share" hover-class="none">分享给朋友</button>

  <view class="block">
    <view class="label">制作规划</view>
    <view class="plan-h">本次会做</view>
    <view wx:for="{{must}}" wx:key="index" class="plan-item">{{item}}</view>
    <view wx:if="{{must.length === 0}}" class="muted">还没写下必须项，继续聊几轮就会出现。</view>
    <view class="plan-h cut">先不做</view>
    <view wx:for="{{cut}}" wx:key="index" class="plan-item">{{item}}</view>
    <view wx:if="{{cut.length === 0}}" class="muted">裁剪项会在收敛范围时出现。</view>
  </view>

  <view class="block">
    <view class="doc-head">
      <view class="label">完整文档</view>
      <view class="copy" bindtap="onCopy">复制全文</view>
    </view>
    <rich-text wx:if="{{html}}" nodes="{{html}}"></rich-text>
    <text wx:if="{{!html}}" class="doc-plain">{{plain}}</text>
  </view>

  <view wx:if="{{fromShare}}" class="share-footer">
    <button class="try-btn ghost" hover-class="none" bindtap="onTryCoCreate">我也来共创</button>
  </view>
</view>

<canvas type="2d" id="shareCard" class="share-canvas"></canvas>
