<view wx:if="{{!ready}}" class="loading">
  <image class="loading-logo" src="{{logoSrc}}" mode="aspectFit" />
  <view class="spinner"></view>
  <view class="muted">正在打开文档…</view>
</view>

<view wx:if="{{ready && empty}}" class="empty">
  <image class="empty-logo" src="{{logoSrc}}" mode="aspectFit" />
  <view class="empty-title">{{fromShare ? '找不到这份分享' : '还没有文档'}}</view>
  <view class="muted">{{fromShare ? '链接可能已失效。你可以自己开一轮共创。' : '回到聊天里再聊几句，出现文档入口后再进来。'}}</view>
  <button wx:if="{{fromShare}}" class="try-btn" hover-class="press" bindtap="onTryCoCreate">我也来共创</button>
</view>

<view wx:if="{{ready && !empty}}" class="wrap">
  <view wx:if="{{fromShare}}" class="share-banner">来自分享的游戏文档</view>
  <view class="cover">
    <image wx:if="{{coverUrl}}" class="cover-img" src="{{coverUrl}}" mode="aspectFill" binderror="onCoverError" />
    <view class="cover-shade">
      <view class="cover-top">
        <view class="cover-badge">{{coverUrl ? '封面' : (coverPending ? '封面生成中' : '封面')}}</view>
        <image class="cover-logo" src="{{logoSrc}}" mode="aspectFit" />
      </view>
      <view class="cover-title">{{title}}</view>
      <view wx:if="{{pitch}}" class="cover-pitch">{{pitch}}</view>
      <view class="cover-brand">NewBee × ForgeaX</view>
    </view>
  </view>
  <view wx:if="{{!fromShare}}" class="cover-actions">
    <view class="regen {{coverPending ? 'off' : ''}}" bindtap="onRegenCover">{{coverPending ? '封面生成中' : '重新生成封面'}}</view>
  </view>

  <view wx:if="{{gameplayMoments.length}}" class="moments">
    <view class="moments-heading">
      <view class="card-title">关键瞬间</view>
    </view>
    <scroll-view scroll-x class="moments-row" show-scrollbar="{{false}}">
      <view class="moments-lead"></view>
      <view wx:for="{{gameplayMoments}}" wx:key="id" class="moment">
        <view class="moment-shot">
          <image
            wx:if="{{item.localUrl && (item.imageStatus === 'ready' || item.imageStatus === 'stale')}}"
            class="moment-photo"
            src="{{item.localUrl}}"
            mode="aspectFill"
            data-url="{{item.localUrl}}"
            bindtap="onPreviewGameplay"
          />
          <view wx:if="{{item.imageStatus === 'queued'}}" class="moment-state">等待生成</view>
          <view wx:if="{{item.imageStatus === 'pending'}}" class="moment-state">正在生成玩法画面…</view>
          <view wx:if="{{item.imageStatus === 'failed'}}" class="moment-state">没画出来</view>
          <view wx:if="{{item.imageStatus === 'stale'}}" class="moment-flag">已过期</view>
          <view
            wx:if="{{!fromShare && (item.imageStatus === 'ready' || item.imageStatus === 'failed' || item.imageStatus === 'stale')}}"
            class="moment-redo"
            data-id="{{item.id}}"
            catchtap="onRegenGameplay"
          >重新生成</view>
        </view>
        <view class="card-title moment-caption">{{item.title}}</view>
        <view wx:if="{{item.description}}" class="card-line-text moment-caption moment-desc">{{item.description}}</view>
      </view>
      <view class="moments-tail"></view>
    </scroll-view>
  </view>

  <view wx:if="{{draft}}" class="draft-bar">这是草稿，还有没写全的部分。可以分享，也可以回去继续聊。</view>

  <view wx:if="{{dna.length}}" class="block dna-block">
    <view class="label">游戏基因</view>
    <scroll-view scroll-x class="dna-row" enable-flex>
      <view
        wx:for="{{dna}}"
        wx:key="id"
        class="dna-chip {{dnaOpen === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onDnaTap"
      >
        <view class="dna-kicker">{{item.label}}</view>
        <view class="dna-short">{{item.text}}</view>
      </view>
    </scroll-view>
    <view wx:if="{{dnaFull}}" class="dna-full">{{dnaFull}}</view>
  </view>

  <view wx:if="{{storyboard.length}}" class="block">
    <view class="label">你怎么玩</view>
    <view class="frame">
      <view class="frame-kicker">{{frameTitle}}</view>
      <view class="frame-text">{{frameText}}</view>
      <view class="frame-nav">
        <view class="frame-dots">
          <view wx:for="{{storyboard}}" wx:key="index" class="dot {{index === storyIndex ? 'on' : ''}}"></view>
        </view>
        <view wx:if="{{storyboard.length > 1}}" class="next" bindtap="onNextFrame">下一步</view>
      </view>
    </view>
  </view>

  <view wx:if="{{loopNodes.length}}" class="block">
    <view class="label">一局怎么转</view>
    <view class="rings">
      <view
        wx:for="{{loopNodes}}"
        wx:key="id"
        class="ring {{loopOpen === item.id ? 'on' : ''}}"
        data-id="{{item.id}}"
        bindtap="onLoopTap"
      >{{item.label}}</view>
    </view>
    <view wx:if="{{loopText}}" class="loop-text">{{loopText}}</view>
  </view>

  <view wx:if="{{!fromShare && sections.length}}" class="patch-hint">点一句，再点修改。</view>
  <view
    wx:for="{{sections}}"
    wx:key="id"
    id="gdd-sec-{{item.id}}"
    class="card {{expandedId === item.id ? 'on' : ''}}"
  >
    <view class="card-h" data-id="{{item.id}}" catchtap="onToggleSection">
      <view class="card-title">{{item.title}}</view>
      <view class="card-chevron">▸</view>
    </view>
    <view id="gdd-fold-{{item.id}}" class="card-fold">
      <view class="card-body">
        <block wx:for="{{item.lines}}" wx:for-item="line" wx:key="id">
          <view
            class="card-line {{fromShare ? '' : 'tap'}} {{selectedLineId === line.id && lineActionsOn ? 'on' : ''}}"
            data-id="{{line.id}}"
            catchtap="onSelectLine"
          >
            <text class="card-line-text">{{line.text}}</text>
          </view>
          <view
            wx:if="{{!fromShare && selectedLineId === line.id}}"
            class="line-actions {{lineActionsOn ? 'on' : ''}}"
          >
            <view class="line-actions-inner">
              <view
                class="line-act primary"
                hover-class="line-act-press"
                catchtap="onPatchLine"
                data-id="{{line.id}}"
                data-text="{{line.text}}"
                data-section="{{item.id}}"
                data-title="{{item.title}}"
              >修改</view>
              <view class="line-act" hover-class="line-act-press" catchtap="onCancelLine">取消</view>
            </view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view id="gdd-full" class="block doc-block">
    <view id="gdd-full-head">
      <view class="doc-head">
        <view class="label">完整文档</view>
        <view class="copy" bindtap="onCopy">复制全文</view>
      </view>
      <view class="doc-name">{{title}}</view>
      <view wx:if="{{pitch}}" class="doc-pitch">一句话 Pitch：{{pitch}}</view>
    </view>
    <view wx:if="{{(html || plain) && !fullDocOpen}}" class="doc-toggle" hover-class="doc-toggle-press" bindtap="onToggleFullDoc">点击展开完整文档 ↓</view>
    <view
      wx:if="{{html || plain}}"
      id="gdd-full-fold"
      class="doc-fold {{fullDocOpen ? 'on' : ''}} {{fullDocMeasure ? 'measure' : ''}} {{fullDocSnap ? 'snap' : ''}} {{fullDocSettled ? 'settled' : ''}}"
      style="height: {{fullDocH}};"
    >
      <view id="gdd-full-body" class="doc-fold-inner">
        <rich-text wx:if="{{html}}" nodes="{{html}}"></rich-text>
        <text wx:else class="doc-plain">{{plain}}</text>
        <view class="doc-toggle" hover-class="doc-toggle-press" bindtap="onToggleFullDoc" data-edge="bottom">点击收起完整文档 ↑</view>
      </view>
    </view>
  </view>

  <view wx:if="{{!fromShare}}" class="share-actions">
    <button class="share-btn" open-type="share" hover-class="press" bindtap="markSheet">分享给朋友</button>
    <button class="export-btn" hover-class="press" bindtap="onExportFile">导出 GDD 文件</button>
  </view>

  <view wx:if="{{fromShare}}" class="share-footer">
    <button class="try-btn ghost" hover-class="press" bindtap="onTryCoCreate">我也来共创</button>
  </view>
</view>

<canvas type="2d" id="shareCard" class="share-canvas"></canvas>
