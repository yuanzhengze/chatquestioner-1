<view class="topscrim" style="height:{{navTop}}px"></view>

<view class="hero">
  <view class="hero-bg">
    <image wx:if="{{!heroFailed}}" class="hero-img" src="{{heroSrc}}" mode="heightFix" binderror="onHeroError" />
    <view class="hero-shade"></view>
  </view>

  <view class="hero-body" style="padding-top:{{navTop}}px">
    <view class="brand" style="min-height:{{navHeight}}px;margin-right:{{capsuleRight}}px">
      <image class="brand-mark" src="{{markSrc}}" mode="aspectFit" />
      <view class="brand-copy">
        <image class="brand-word" src="{{wordmarkSrc}}" mode="heightFix" aria-label="ForgeAX" />
        <view class="brand-kicker">游戏创意前置共创</view>
      </view>
    </view>

    <view class="hero-gap"></view>

    <view class="eyebrow">
      <view class="eyebrow-bar"></view>
      <text>灵感引导 · 游戏文档</text>
    </view>
    <view class="slogan">
      <view class="slogan-line">{{sloganLines[0]}}</view>
      <view class="slogan-line">{{sloganLines[1]}}</view>
      <view class="slogan-line em">{{sloganLines[2]}}</view>
    </view>
    <view class="desc">{{subline}}</view>

    <view class="ctas">
      <view wx:if="{{hasLast}}" class="cta primary" hover-class="press" aria-role="button" bindtap="onStart">
        <image class="cta-icon" src="/images/home/icon-continue-dark.png" />
        <text class="cta-label">继续共创</text>
        <image class="cta-arrow" src="/images/home/icon-arrow-dark.png" />
      </view>
      <view class="cta {{hasLast ? 'secondary' : 'primary'}}" hover-class="press" aria-role="button" bindtap="onNewSession">
        <image class="cta-icon" src="{{hasLast ? '/images/home/icon-start-light.png' : '/images/home/icon-start-dark.png'}}" />
        <text class="cta-label">开始共创</text>
        <image class="cta-arrow" src="{{hasLast ? '/images/home/icon-arrow-light.png' : '/images/home/icon-arrow-dark.png'}}" />
      </view>
    </view>
  </view>
</view>

<view wx:if="{{exampleCols[0].items.length}}" class="feed">
  <view class="feed-title"><view class="feed-bar"></view>示例脑洞</view>
  <view class="feed-cols">
    <view wx:for="{{exampleCols}}" wx:for-item="col" wx:key="key" class="feed-col {{col.key}}">
      <view
        wx:for="{{col.items}}"
        wx:key="id"
        class="ex"
        hover-class="press"
        data-share="{{item.shareId}}"
        bindtap="onOpenExample"
      >
        <view class="ex-cover {{item.tall ? 'tall' : ''}}">
          <image wx:if="{{item.cover}}" class="ex-img" src="{{item.cover}}" mode="aspectFill" />
        </view>
        <view wx:if="{{item.title}}" class="ex-body">
          <view class="ex-title">{{item.title}}</view>
          <view wx:if="{{item.pitch}}" class="ex-pitch">{{item.pitch}}</view>
        </view>
      </view>
    </view>
  </view>
</view>

<nb-consent show="{{showConsent}}" bind:agree="onAgreeConsent" bind:close="onCloseConsent" bind:legal="onConsentLegal" />

<view wx:if="{{showLegal}}" class="mask" catchtap="onCloseLegal">
  <view class="sheet" catchtap="noop">
    <view class="sheet-title">{{legalTitle}}</view>
    <scroll-view scroll-y class="sheet-body">
      <text class="sheet-text">{{legalBody}}</text>
    </scroll-view>
    <button class="btn primary" hover-class="press" bindtap="onCloseLegal">知道了</button>
  </view>
</view>
