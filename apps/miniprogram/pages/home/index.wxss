page {
  background: var(--bg-canvas);
  color: var(--text);
}

/* 滚动后让状态栏的时间、电量始终压在深色上 */
.topscrim {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 10;
  pointer-events: none;
  background: linear-gradient(180deg, rgba(26, 28, 31, 0.85) 0%, rgba(26, 28, 31, 0) 100%);
}

/* 75vh：首屏底部约四分之一留给 Feed。内容更高时 Hero 跟着长，不压缩文字。 */
.hero {
  position: relative;
  min-height: 75vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
}
.hero-bg {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  overflow: hidden;
}
/* 按图高等比铺满，右侧对齐后再右移图宽的 10%：横图主体落在屏幕右侧约 3/4 处，各档一致 */
.hero-img {
  position: absolute;
  top: 0;
  right: 0;
  height: 100%;
  transform: translateX(10%);
}
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background:
    linear-gradient(180deg, rgba(26, 28, 31, 0) 46%, rgba(26, 28, 31, 0.78) 80%, #1A1C1F 100%),
    linear-gradient(90deg, rgba(26, 28, 31, 0.92) 0%, rgba(26, 28, 31, 0.66) 42%, rgba(26, 28, 31, 0.14) 74%, rgba(26, 28, 31, 0) 100%);
}
.hero-body {
  position: relative;
  flex: 1;
  display: flex;
  flex-direction: column;
  padding: 0 40rpx 48rpx;
}

.brand {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}
.brand-mark {
  width: 60rpx;
  height: 60rpx;
  flex-shrink: 0;
  margin-right: 18rpx;
}
.brand-copy {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  min-width: 0;
}
.brand-word {
  height: 34rpx;
}
.brand-kicker {
  margin-top: 6rpx;
  font-size: 20rpx;
  line-height: 1.2;
  letter-spacing: 0.12em;
  color: var(--text-2);
}

.hero-gap {
  flex: 1;
  min-height: 56rpx;
}

.eyebrow {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 22rpx;
  line-height: 1.4;
  letter-spacing: 0.16em;
  color: var(--text-2);
}
.eyebrow-bar {
  width: 40rpx;
  height: 4rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  border-radius: 2rpx;
  background: var(--brand);
}

.slogan {
  flex-shrink: 0;
  font-size: 64rpx;
  font-weight: 700;
  line-height: 1.36;
  letter-spacing: 0.05em;
  color: var(--text);
  text-shadow: 0 2rpx 24rpx rgba(0, 0, 0, 0.35);
}
.slogan-line {
  display: block;
  white-space: nowrap;
}
.slogan-line.em {
  color: var(--brand);
}
.desc {
  flex-shrink: 0;
  max-width: 19.5em;
  margin-top: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: var(--text-2);
}

/* 400rpx：从正文左沿起，右端停在屏宽约 59%（中线偏右），rpx 随屏宽等比 */
.ctas {
  flex-shrink: 0;
  width: 400rpx;
  margin-top: 44rpx;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.cta {
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 28rpx 0 44rpx;
  box-sizing: border-box;
  border-radius: var(--r-full);
  font-size: 30rpx;
  line-height: 1;
}
.cta.primary {
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
  font-weight: 600;
}
.cta.secondary {
  background: rgba(26, 28, 31, 0.6);
  color: var(--text);
  border: 1px solid rgba(237, 237, 237, 0.24);
  font-weight: 500;
}
.cta.primary.press {
  background: var(--action-primary-pressed);
}
.cta.secondary.press {
  background: var(--action-secondary-hover);
}
.cta-icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.cta-label {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  text-align: left;
}
.cta-arrow {
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
  opacity: 0.72;
}

.feed {
  padding: 8rpx 40rpx 40rpx;
}
.feed-title {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.feed-bar {
  width: 32rpx;
  height: 4rpx;
  margin-right: 16rpx;
  border-radius: 2rpx;
  background: var(--brand);
}
.feed-cols {
  display: flex;
  align-items: flex-start;
}
.feed-col {
  flex: 1;
  min-width: 0;
}
.feed-col.right {
  margin-left: 20rpx;
}
/* 一张卡 = 封面 + 游戏名 + 一句话，同一块面、同一个圆角；封面顶角由卡片裁出 */
.ex {
  margin-bottom: 20rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: var(--bg-elevated);
}
.ex.press {
  background: var(--hover);
}
/* 封面统一方图，左右列交错用 1:1 / 4:5 裁切（aspectFill 只裁不拉伸） */
.ex-cover {
  position: relative;
  width: 100%;
  padding-top: 100%;
  overflow: hidden;
  background: var(--bg-floating);
}
.ex-cover.tall {
  padding-top: 125%;
}
.ex-img {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}
.ex-body {
  padding: 16rpx 20rpx 20rpx;
}
.ex-title {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
}
.ex-pitch {
  display: -webkit-box;
  margin-top: 6rpx;
  overflow: hidden;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
}

.mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 50;
  display: flex;
  align-items: flex-end;
  background: var(--overlay);
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 28rpx 32rpx 40rpx;
  background: var(--bg-base);
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1px solid var(--border-subtle);
}
.sheet-title {
  margin-bottom: 16rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.sheet-body {
  max-height: 42vh;
  margin-bottom: 32rpx;
}
.sheet-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
  white-space: pre-wrap;
}
.btn {
  margin: 0;
  padding: 0;
  height: 80rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  border-radius: var(--r-full);
  font-size: 28rpx;
  font-weight: 500;
}
.btn::after {
  border: none;
}
.btn.primary {
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
}
.btn.primary.press {
  background: var(--action-primary-pressed) !important;
}
