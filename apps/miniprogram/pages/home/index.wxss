page {
  height: 100%;
  background: var(--bg-canvas);
  color: var(--text);
}

.pager {
  height: 100%;
}

.screen {
  height: 100%;
  box-sizing: border-box;
}
.screen.one {
  display: flex;
  flex-direction: column;
  padding: 12rpx 32rpx 8rpx;
}
.screen.two {
  height: 100%;
  box-sizing: border-box;
  padding: 24rpx 32rpx 32rpx;
}

.brandrow {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 64rpx;
  padding-bottom: 12rpx;
  border-bottom: 1px solid var(--divider);
}
.mark {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.mark-logo {
  width: 56rpx;
  height: 56rpx;
}
.brand-copy { min-width: 0; }
.wordmark {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--text);
}
.kicker {
  margin-top: 2rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--text-3);
}

.window {
  width: 100%;
  flex: 1;
  min-height: 180rpx;
  margin-top: 16rpx;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 32rpx;
}
.window-bar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 48rpx;
  padding: 0 16rpx;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--divider);
}
.window-body {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-canvas);
}
.face {
  width: 220rpx;
  height: 220rpx;
  animation: logoIdle 3.2s ease-in-out infinite;
}
@keyframes logoIdle {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.04); opacity: 0.92; }
}
.face-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  color: var(--brand);
}

.copy {
  flex-shrink: 0;
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 1px solid var(--divider);
}
.eyebrow {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--text-3);
}
.eyebrow-bar {
  width: 36rpx;
  height: 4rpx;
  background: var(--brand);
  flex-shrink: 0;
}
.title {
  font-size: 48rpx;
  font-weight: 600;
  line-height: 1.3;
  letter-spacing: -0.03em;
  color: var(--text);
}
.title-line {
  display: block;
  white-space: nowrap;
}
.em { color: var(--brand); }
.sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--text-2);
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 20rpx;
  flex-shrink: 0;
}
.btn {
  margin: 0;
  padding: 0;
  height: 80rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  border-radius: var(--r-full);
  font-size: 28rpx;
  font-weight: 500;
}
.btn::after { border: none; }
.btn.primary {
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
  font-weight: 500;
}
.btn.primary.off {
  background: var(--action-disabled-bg);
  color: var(--action-disabled-fg);
  opacity: 1;
}
.btn.ghost {
  background: var(--action-secondary-bg);
  color: var(--action-secondary-fg);
  border: 1px solid var(--border);
}
.press { transform: scale(var(--press-scale)); }
.btn.primary.press {
  background: var(--action-primary-pressed) !important;
  color: var(--action-primary-fg) !important;
  border-color: transparent !important;
}
.btn.ghost.press {
  background: var(--action-secondary-hover) !important;
  color: var(--text) !important;
  border-color: var(--border) !important;
}
.consent {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 4rpx 8rpx;
}
.box {
  flex-shrink: 0;
  box-sizing: border-box;
  width: 36rpx;
  height: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8rpx;
  border: 1px solid var(--border);
  background: var(--bg-base);
  color: var(--text-on-bright);
  font-size: 22rpx;
  line-height: 1;
}
.box.on {
  background: var(--choice);
  border-color: var(--choice);
  color: var(--text);
}
.consent-text {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  line-height: 36rpx;
  color: var(--text-3);
}
.link { color: var(--text-link); }

.hint {
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0 4rpx;
}
.hint-float {
  animation: hintBounce 1.6s ease-in-out infinite;
}
.hint-float.up {
  animation: hintBounceUp 1.6s ease-in-out infinite;
}
.hint-chevron {
  width: 16rpx;
  height: 16rpx;
  border-right: 3rpx solid var(--brand);
  border-bottom: 3rpx solid var(--brand);
  transform: rotate(45deg);
}
.hint-chevron.up {
  transform: rotate(-135deg);
}
.hint.back {
  padding: 4rpx 0 20rpx;
}
.hint-text {
  margin-top: 8rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: var(--text-3);
}
@keyframes hintBounce {
  0%, 100% { transform: translateY(0); opacity: 0.45; }
  50% { transform: translateY(8rpx); opacity: 1; }
}
@keyframes hintBounceUp {
  0%, 100% { transform: translateY(0); opacity: 0.45; }
  50% { transform: translateY(-8rpx); opacity: 1; }
}

.section { margin-bottom: 36rpx; }
.section-label {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text);
}
.section-hint {
  margin: 8rpx 0 16rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-3);
}
.idea {
  margin-bottom: 12rpx;
  padding: 20rpx 24rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 16rpx;
  font-size: 26rpx;
  line-height: 1.5;
  color: var(--text);
}
.case {
  margin-bottom: 12rpx;
  padding: 24rpx 28rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
}
.case-badge {
  display: inline-block;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  background: var(--brand-tint);
  border: 1px solid var(--brand);
  color: var(--brand);
  font-size: 20rpx;
}
.case-title {
  margin-top: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text);
}
.case-pitch {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
}

.mask {
  position: fixed;
  inset: 0;
  background: var(--overlay);
  display: flex;
  align-items: flex-end;
  z-index: 50;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 28rpx 32rpx 40rpx;
  background: var(--bg-base);
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1px solid var(--border-subtle);
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}
.sheet-body {
  max-height: 42vh;
  margin-bottom: 20rpx;
}
.sheet-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
  white-space: pre-wrap;
}
.url {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  font-size: 22rpx;
  color: var(--text-link);
  word-break: break-all;
}
.sheet-btn { margin-top: 12rpx; }
