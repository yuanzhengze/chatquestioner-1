.page {
  height: 100vh;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 48rpx 48rpx 64rpx;
  background:
    radial-gradient(70% 50% at 50% 18%, rgba(232, 148, 58, 0.16) 0%, transparent 70%),
    #FAF8F4;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.halo {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin-bottom: 36rpx;
}

.glow {
  position: absolute;
  inset: -10%;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 45%, rgba(255, 201, 77, 0.36) 0%, transparent 62%);
}

.face,
.face-fallback {
  position: relative;
  width: 100%;
  height: 100%;
}

.face-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 160rpx;
  line-height: 1;
}

.brand {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #3A3530;
}

.slogan {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #3A3530;
}

.sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8A8175;
}

.actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 600;
}

.btn::after { border: none; }

.btn.primary {
  background: #E8943A;
  color: #fff;
}

.btn.primary.off {
  opacity: 0.45;
}

.btn.ghost {
  background: #FFFFFF;
  color: #3A3530;
  border: 1px solid #ECE6DC;
}

.consent {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 8rpx 0;
}

.box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border-radius: 8rpx;
  border: 2rpx solid #C9C0B4;
  background: #fff;
  color: #fff;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}

.box.on {
  background: #E8943A;
  border-color: #E8943A;
}

.consent-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8A8175;
}

.link {
  color: #C77B6B;
}

.mask {
  position: fixed;
  inset: 0;
  background: rgba(58, 53, 48, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}

.sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 36rpx 40rpx 48rpx;
  background: #FAF8F4;
  border-radius: 28rpx 28rpx 0 0;
}

.sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A3530;
  margin-bottom: 20rpx;
}

.sheet-body {
  max-height: 42vh;
  margin-bottom: 24rpx;
}

.sheet-text {
  font-size: 26rpx;
  line-height: 1.65;
  color: #5A534C;
  white-space: pre-wrap;
}

.url {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1px solid #ECE6DC;
  font-size: 24rpx;
  color: #3A3530;
  word-break: break-all;
}

.sheet-btn { margin-top: 12rpx; }
