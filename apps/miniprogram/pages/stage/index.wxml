<view class="page">
  <view class="header">
    <view class="header-row">
      <view class="header-left">
        <view class="icon-btn" bindtap="onBackToHome" aria-role="button" aria-label="返回首页">
          <view class="i-chevron"></view>
        </view>
      </view>
      <view class="header-mark">
        <nb-avatar src="{{poster}}" mark="{{true}}"></nb-avatar>
      </view>
      <view class="title">NewBee · 游戏共创</view>
      <view class="header-menu">
        <view class="icon-btn" bindtap="onToggleMenu" aria-role="button" aria-label="新共创或历史">
          <view class="i-menu {{showMenu ? 'on' : ''}}">
            <view class="i-menu-bar"></view>
            <view class="i-menu-bar"></view>
            <view class="i-menu-bar"></view>
          </view>
        </view>
        <view wx:if="{{showMenu}}" class="menu-pop" catchtap="noop">
          <view class="menu-item" hover-class="menu-on" bindtap="onNewSession">新共创</view>
          <view class="menu-item" hover-class="menu-on" bindtap="onOpenHistory">历史</view>
        </view>
      </view>
    </view>
    <view wx:if="{{stageLabel}}" class="stage-label">{{stageLabel}}</view>
    <view wx:if="{{error}}" class="err">出错：{{error}}</view>
  </view>

  <view class="stream-wrap">
    <nb-context-stream
      id="ctx-stream"
      messages="{{messages}}"
      busy="{{busy}}"
      opts-freeze="{{optsFreeze}}"
      opts-ease="{{optsEase}}"
      opts-gone="{{optsGone}}"
      probe-text="{{probeText}}"
      bind:choose="onStreamChoose"
      bind:optsclear="onOptsClear"
    ></nb-context-stream>
  </view>

  <!--
    文档卡：聊天列表和输入框之间自己占一块高度的常驻入口。
    没有文档时节点不存在、不占高度；出现时像来了一条消息那样淡入上移，
    它占掉的那截高度由滚动区让出 —— 见 pages/stage/index.ts 的 dockGdd。
  -->
  <view wx:if="{{showGdd}}" id="gdd-dock" class="stage">
    <view class="gdd-entry" hover-class="gdd-press" bindtap="onOpenGdd">
      <view class="gdd-kicker">{{gddKicker}}</view>
      <view class="gdd-name">{{gddTitle || '未命名游戏'}}</view>
      <view class="gdd-go">{{gddGo}}</view>
    </view>
  </view>

  <!--
    变形层：选中的那张卡脱离列表飞到真实用户气泡上。
    只有这一个节点在动，列表零回流。样式起点必须和 context-stream 的 .opt 一致。
  -->
  <view
    wx:if="{{chipShow}}"
    class="chip {{chipOn ? 'to-user' : 'from-opt'}}"
    style="left: {{chipLeft}}px; top: {{chipTop}}px; width: {{chipW}}px; height: {{chipH}}px; transform: translate({{chipDx}}px, {{chipDy}}px) scale({{chipScale}});"
  >
    <view class="chip-label">{{chipLabel}}</view>
    <view class="chip-detail">{{chipDetail}}</view>
  </view>

  <!--
    输入框是前景遮罩：飞行层 z-index 更低，经过这里会被这块不透明底盖住。
    组件内部的 z-index 出不了组件，所以叠层必须写在页面这一层。
  -->
  <view class="composer-dock">
    <nb-composer
      busy="{{busy}}"
      mode="{{composerMode}}"
      disabled="{{busy || picking}}"
      safe-bottom="{{safeBottom}}"
      keyboard-height="{{keyboardHeight}}"
      seed="{{composerSeed}}"
      seed-seq="{{seedSeq}}"
      bind:send="onSend"
      bind:typing="onTyping"
    />
  </view>

  <view wx:if="{{showMenu}}" class="menu-mask" catchtap="onCloseMenu"></view>

  <view wx:if="{{showHistory}}" class="hist-mask" catchtap="onCloseHistory">
    <view class="hist-panel" catchtap="noop">
      <view class="hist-head">共创历史</view>
      <view wx:if="{{historyItems.length === 0}}" class="hist-empty">还没有保存的共创。先聊一句就会出现在这里。</view>
      <scroll-view wx:if="{{historyItems.length > 0}}" scroll-y class="hist-list">
        <view
          wx:for="{{historyItems}}"
          wx:key="id"
          class="hist-item {{item.current ? 'on' : ''}}"
        >
          <view class="hist-main" data-id="{{item.id}}" bindtap="onPickSession">
            <view class="hist-title">{{item.title}}</view>
          </view>
          <view class="hist-del" data-id="{{item.id}}" catchtap="onDeleteSession">删除</view>
        </view>
      </scroll-view>
      <view class="hist-close" bindtap="onCloseHistory">关闭</view>
    </view>
  </view>

  <view wx:if="{{showConsent}}" class="consent-mask" catchtap="onCloseConsent">
    <view class="consent-card" catchtap="noop">
      <view class="consent-title">开始共创前请先确认</view>
      <view class="consent-copy">勾选同意后就可以说话。协议可随时在「我的」里再看。</view>
      <view class="consent-row" bindtap="onToggleConsent">
        <view class="box {{consentChecked ? 'on' : ''}}">{{consentChecked ? '✓' : ''}}</view>
        <view class="consent-text">
          我已阅读并同意
          <text class="link" catchtap="onShowLegal" data-kind="terms">《用户协议》</text>
          与
          <text class="link" catchtap="onShowLegal" data-kind="privacy">《隐私政策》</text>
        </view>
      </view>
      <view class="consent-actions">
        <view class="btn ghost" bindtap="onCloseConsent">稍后再说</view>
        <view class="btn primary {{consentChecked ? '' : 'off'}}" bindtap="onConfirmConsent">同意并继续</view>
      </view>
    </view>
  </view>

  <view wx:if="{{showLegal}}" class="legal-mask" catchtap="onCloseLegal">
    <view class="sheet" catchtap="noop">
      <view class="sheet-title">{{legalTitle}}</view>
      <scroll-view scroll-y class="sheet-body">
        <text class="sheet-text">{{legalBody}}</text>
      </scroll-view>
      <view class="btn primary" bindtap="onCloseLegal">知道了</view>
    </view>
  </view>

  <view wx:if="{{openingGdd}}" class="loading-mask">
    <view class="loading-card">
      <image class="loading-logo" src="{{logoSrc}}" mode="aspectFit" />
      <view class="spinner"></view>
      <view class="loading-text">正在打开文档…</view>
    </view>
  </view>
</view>
