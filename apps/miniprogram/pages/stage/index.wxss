.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF8F4;
  overflow: hidden;
}
.header {
  padding: 12rpx 32rpx 8rpx;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.header-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 4rpx;
}
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.i-chevron {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #E8943A;
  border-bottom: 4rpx solid #E8943A;
  transform: rotate(45deg);
  margin-left: 6rpx;
}
.i-clock {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #E8943A;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
}
.i-clock-h {
  position: absolute;
  left: 13rpx;
  top: 6rpx;
  width: 4rpx;
  height: 10rpx;
  background: #E8943A;
  border-radius: 2rpx;
}
.i-clock-m {
  position: absolute;
  left: 13rpx;
  top: 14rpx;
  width: 10rpx;
  height: 4rpx;
  background: #E8943A;
  border-radius: 2rpx;
}
.title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 700;
  color: #3A3530;
  letter-spacing: 0.01em;
}
.new-chat {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #E8943A;
  padding: 8rpx 0 8rpx 8rpx;
}
.stage-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8A8175;
}
.err {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #C7564B;
}
/* 对话是主区域：占满剩余高度，内部 scroll-view 自动滚到底。 */
.stream-wrap {
  flex: 1 1 auto;
  min-height: 0;
}
/* 形象本身不滚动。选项先只露标题，点开再长高，整组贴在输入框上方，避免第三张被卷走。 */
.stage {
  flex: 0 0 auto;
  box-sizing: border-box;
  padding: 8rpx 32rpx 16rpx;
  background: radial-gradient(60% 50% at 50% 38%, rgba(232, 148, 58, 0.12) 0%, transparent 70%);
}
.stage-panel {
  width: 100%;
}
.options {
  width: 100%;
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.gdd-entry {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1px solid #ECE6DC;
  border-radius: 20px;
  box-shadow: 0 8rpx 24rpx rgba(74, 59, 42, 0.08);
}
.gdd-kicker {
  font-size: 22rpx;
  color: #5B8A8A;
  font-weight: 600;
}
.gdd-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #3A3530;
}
.gdd-go {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #E8943A;
}
.avatar-row {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}
.done-bar {
  padding: 20rpx 32rpx 24rpx;
  text-align: center;
  color: #8A8175;
  font-size: 26rpx;
  background: #FAF8F4;
}
.loading-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(250, 248, 244, 0.72);
}
.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 56rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 12rpx 40rpx rgba(74, 59, 42, 0.12);
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #F3EDE3;
  border-top-color: #E8943A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #8A8175;
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* ---------- 首屏授权门（原 pages/landing 的样式，加 gate- 前缀避免与聊天页冲突） ---------- */
.gate {
  position: fixed;
  inset: 0;
  z-index: 10;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  padding: 48rpx 48rpx 64rpx;
  background:
    radial-gradient(70% 50% at 50% 18%, rgba(232, 148, 58, 0.16) 0%, transparent 70%),
    #FAF8F4;
}
.gate-hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}
.gate-halo {
  position: relative;
  width: 280rpx;
  height: 280rpx;
  margin-bottom: 36rpx;
}
.gate-glow {
  position: absolute;
  inset: -10%;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 45%, rgba(255, 201, 77, 0.36) 0%, transparent 62%);
}
.gate-face {
  position: relative;
  width: 100%;
  height: 100%;
}
.gate-face-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 160rpx;
  line-height: 1;
}
.gate-brand {
  font-size: 52rpx;
  font-weight: 700;
  letter-spacing: 0.04em;
  color: #3A3530;
}
.gate-slogan {
  margin-top: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  line-height: 1.45;
  color: #3A3530;
}
.gate-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8A8175;
}
.gate-actions {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.hist-mask {
  position: fixed;
  inset: 0;
  z-index: 25;
  background: rgba(58, 53, 48, 0.4);
  display: flex;
  align-items: stretch;
  justify-content: flex-start;
}
.hist-panel {
  width: 78%;
  max-width: 560rpx;
  box-sizing: border-box;
  padding: 48rpx 32rpx 40rpx;
  background: #FAF8F4;
  display: flex;
  flex-direction: column;
}
.hist-head {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A3530;
  margin-bottom: 24rpx;
}
.hist-empty {
  font-size: 26rpx;
  line-height: 1.55;
  color: #8A8175;
}
.hist-list {
  flex: 1;
  max-height: 70vh;
}
.hist-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 8rpx 20rpx 16rpx;
  border-bottom: 1px solid #ECE6DC;
}
.hist-item.on {
  background: #FBE7CC;
  border-radius: 12rpx;
}
.hist-main {
  flex: 1;
  min-width: 0;
  padding: 4rpx 8rpx 4rpx 0;
}
.hist-title {
  font-size: 28rpx;
  color: #3A3530;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hist-del {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #C77B6B;
}
.hist-close { margin-top: 24rpx; }
.gate-btn {
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 600;
}
.gate-btn::after { border: none; }
.gate-btn.primary {
  background: #E8943A;
  color: #fff;
}
.gate-btn.primary.off { opacity: 0.45; }
.gate-btn.ghost {
  background: #FFFFFF;
  color: #3A3530;
  border: 1px solid #ECE6DC;
}
.gate-consent {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 8rpx 8rpx 0;
}
.gate-box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border-radius: 8rpx;
  border: 2rpx solid #C9C0B4;
  background: #fff;
  color: #fff;
  font-size: 24rpx;
  line-height: 32rpx;
  text-align: center;
}
.gate-box.on {
  background: #E8943A;
  border-color: #E8943A;
}
.gate-consent-text {
  flex: 1;
  font-size: 24rpx;
  line-height: 1.55;
  color: #8A8175;
}
.gate-link { color: #C77B6B; }
.gate-mask {
  position: fixed;
  inset: 0;
  background: rgba(58, 53, 48, 0.4);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}
.gate-sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 36rpx 40rpx 48rpx;
  background: #FAF8F4;
  border-radius: 28rpx 28rpx 0 0;
}
.gate-sheet-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A3530;
  margin-bottom: 20rpx;
}
.gate-sheet-body {
  max-height: 42vh;
  margin-bottom: 24rpx;
}
.gate-sheet-text {
  font-size: 26rpx;
  line-height: 1.65;
  color: #5A534C;
  white-space: pre-wrap;
}
.gate-url {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 16rpx;
  background: #fff;
  border: 1px solid #ECE6DC;
  font-size: 24rpx;
  color: #3A3530;
  word-break: break-all;
}
.gate-sheet-btn { margin-top: 12rpx; }
