.page {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF8F4;
}
.header {
  padding: 12rpx 32rpx 8rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A3530;
  letter-spacing: 0.01em;
}
.stage-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8A8175;
}
.err {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #C7564B;
}
.stream-wrap {
  flex: 0 1 auto;
  min-height: 80rpx;
}
.stage {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 32rpx 16rpx;
  background: radial-gradient(60% 50% at 50% 38%, rgba(232, 148, 58, 0.12) 0%, transparent 70%);
}
.options {
  width: 100%;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.gdd-entry {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border: 1px solid #ECE6DC;
  border-radius: 20px;
  box-shadow: 0 8rpx 24rpx rgba(74, 59, 42, 0.08);
}
.gdd-kicker {
  font-size: 22rpx;
  color: #5B8A8A;
  font-weight: 600;
}
.gdd-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #3A3530;
}
.gdd-go {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #E8943A;
}
.avatar-row {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}
.done-bar {
  padding: 20rpx 32rpx 24rpx;
  text-align: center;
  color: #8A8175;
  font-size: 26rpx;
  background: #FAF8F4;
}
