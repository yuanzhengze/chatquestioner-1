page { height: 100%; background: var(--bg-canvas); }
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: var(--bg-canvas);
  overflow: hidden;
}
.header {
  position: relative;
  z-index: 70;
  padding: 12rpx 32rpx 8rpx;
  background: var(--bg-elevated);
  border-bottom: 1px solid var(--divider);
}
/**
 * 历史侧栏从屏幕顶端开始画。顶栏平时 70 会盖住侧栏上面一截（标题和第一张卡）。
 * 侧栏打开时菜单已经收起，顶栏不再建层，回到普通文档流，落到遮罩 36 和侧栏 37 下面。
 */
.header.under {
  z-index: auto;
}
.header-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.header-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 4rpx;
}
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.i-chevron {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid var(--brand);
  border-bottom: 4rpx solid var(--brand);
  transform: rotate(45deg);
  margin-left: 6rpx;
}
/** 原来夹在对话和输入框之间的大 Logo 收到这里，对话因此铺满整块高度。 */
.header-mark {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  margin-right: 6rpx;
}
.title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--text);
  letter-spacing: 0.01em;
}
.header-menu {
  position: relative;
  z-index: 81;
  flex-shrink: 0;
}
.i-menu {
  width: 32rpx;
  height: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.i-menu-bar {
  height: 4rpx;
  border-radius: 2rpx;
  background: var(--brand);
}
.i-menu.on .i-menu-bar {
  background: var(--text);
}
.menu-mask {
  position: fixed;
  inset: 0;
  z-index: 60;
}
.menu-pop {
  position: absolute;
  right: 0;
  top: 72rpx;
  min-width: 200rpx;
  padding: 8rpx;
  box-sizing: border-box;
  background: var(--bg-floating);
  border: 1px solid var(--border-subtle);
  border-radius: var(--r-panel);
  animation: menuIn var(--dur-fast) var(--ease-out) both;
}
@keyframes menuIn {
  from { opacity: 0; transform: translateY(-8rpx); }
  to { opacity: 1; transform: none; }
}
.menu-item {
  padding: 18rpx 24rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: var(--text);
}
.menu-on {
  background: var(--hover);
}
.stage-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}
.err {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--error);
}
.stream-wrap {
  flex: 1 1 auto;
  min-height: 0;
}
/**
 * 输入框前景。组件内部的 z-index 出不了组件，叠层写在这一层。
 * 高于飞行层（30）和文档卡（32），低于历史遮罩（36）和打开文档的等待层（38）。
 * 不透明底盖住从下面穿过的飞行动画。
 */
.composer-dock {
  position: relative;
  z-index: 35;
  flex: 0 0 auto;
  background: var(--bg-base);
}
/**
 * 文档卡自己的一块，不属于对话空间：flex 兄弟，夹在滚动区和输入框之间。
 * 键盘弹出时输入框变高，这一块跟着被挤上去，不用另外处理。
 * 高于飞行层、低于输入框。历史侧栏和「正在打开文档」都在它上面。
 */
.stage {
  position: relative;
  z-index: 32;
  flex: 0 0 auto;
  box-sizing: border-box;
  padding: 12rpx 32rpx 16rpx;
  /** 只动 opacity 和 transform，不影响它已经占下的高度。 */
  animation: dockIn var(--dur-panel) var(--ease-out) both;
}
@keyframes dockIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: none; }
}
.gdd-press {
  background: var(--bg-elevated);
}

/**
 * Option → User Message 变形层。
 * 位置走 transform（合成层），尺寸和外观各自过渡；整段只有这一个节点在动。
 * .from-opt 的四项必须和 context-stream 的 .opt 逐字一致，否则接手那一帧会跳。
 */
.chip {
  position: fixed;
  /** 低于输入框：上滑后轨迹从输入框底下穿过去，不会画到它上面。 */
  z-index: 30;
  box-sizing: border-box;
  pointer-events: none;
  overflow: hidden;
  transform-origin: top left;
  white-space: pre-wrap;
  will-change: transform, width, height;
  transition:
    transform var(--dur-fly) var(--ease-out),
    width var(--dur-fly) var(--ease-out),
    height var(--dur-fly) var(--ease-out),
    padding var(--dur-fly) var(--ease-out),
    border-radius var(--dur-fly) var(--ease-out),
    background-color var(--dur-fly) var(--ease-out),
    border-color var(--dur-fly) var(--ease-out),
    color var(--dur-fly) var(--ease-out);
}
.chip.from-opt {
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  color: var(--text);
}
/** 终点必须和 context-stream 的 .bubble.me 逐项一致：内边距、圆角、透明 1px 边框、15px / 22px / 400。 */
.chip.to-user {
  padding: 10px 14px;
  border-radius: 18px;
  background: var(--brand);
  border: 1px solid transparent;
  color: var(--text-on-bright);
}
.chip-label {
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1.4;
  transition:
    font-size var(--dur-fly) var(--ease-out),
    font-weight var(--dur-fly) var(--ease-out),
    line-height var(--dur-fly) var(--ease-out);
}
.chip.to-user .chip-label {
  font-size: 15px;
  font-weight: 400;
  line-height: 22px;
}
.chip-detail {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
  max-height: 240rpx;
  opacity: 1;
  overflow: hidden;
  transition:
    max-height var(--dur-fly) var(--ease-out),
    margin-top var(--dur-fly) var(--ease-out),
    opacity var(--dur-fast) var(--ease-out);
}
.chip.to-user .chip-detail {
  margin-top: 0;
  max-height: 0;
  opacity: 0;
}
.gdd-entry {
  width: 100%;
  box-sizing: border-box;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 32rpx;
  overflow: hidden;
}
.gdd-main {
  display: flex;
  gap: 20rpx;
  padding: 20rpx;
}
.gdd-cover {
  width: 200rpx;
  height: 150rpx;
  flex-shrink: 0;
  border-radius: 16rpx;
  overflow: hidden;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
}
.gdd-cover-img { width: 100%; height: 100%; }
.gdd-cover-label {
  padding: 0 12rpx;
  font-size: 22rpx;
  line-height: 1.4;
  text-align: center;
  color: var(--text-3);
}
.gdd-copy {
  flex: 1;
  min-width: 0;
}
.gdd-kicker {
  font-size: 22rpx;
  color: var(--brand);
  font-weight: 600;
}
.gdd-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  line-height: 1.35;
  color: var(--text);
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.gdd-pitch {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.45;
  color: var(--text-2);
  overflow: hidden;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
}
.gdd-go {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--brand);
}
.gdd-actions {
  display: flex;
  border-top: 1px solid var(--divider);
}
.gdd-act {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 22rpx 12rpx;
  background: transparent;
  border: none;
  border-radius: 0;
  font-size: 26rpx;
  font-weight: 700;
  font-family: inherit;
  line-height: 1.4;
  color: var(--brand);
  text-align: center;
}
.gdd-act + .gdd-act { border-left: 1px solid var(--divider); }
button.gdd-act {
  font-weight: 700;
  font-size: 26rpx;
}
button.gdd-act::after { border: none; }
.gdd-act-press { background: var(--hover); }
.share-canvas {
  position: fixed;
  left: 0;
  top: 0;
  width: 500px;
  height: 400px;
  transform: translateX(-120%);
  pointer-events: none;
}
.done-bar {
  padding: 20rpx 32rpx 24rpx;
  text-align: center;
  color: var(--text-3);
  font-size: 26rpx;
  background: var(--bg-canvas);
}
.loading-mask {
  position: fixed;
  inset: 0;
  /** 高于历史侧栏（37），低于同意弹层（40）。只在打开预览时存在。 */
  z-index: 38;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--overlay);
}
.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 56rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
}
.loading-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid var(--border-subtle);
  border-top-color: var(--brand);
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: var(--text-2);
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.hist-mask {
  position: fixed;
  inset: 0;
  z-index: 36;
  background: var(--overlay);
}
.hist-panel {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  z-index: 37;
  width: 76%;
  max-width: 560rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 28rpx 0 calc(24rpx + env(safe-area-inset-bottom));
  background: var(--bg-base);
  border-right: 1px solid var(--border-subtle);
  animation: histIn var(--dur-panel) var(--ease-out);
}
@keyframes histIn {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}
.hist-head {
  flex: 0 0 auto;
  padding: 0 28rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  border-bottom: 1px solid var(--divider);
}
.hist-empty {
  flex: 1 1 auto;
  padding: 20rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: var(--text-2);
}
/** 标题、列表、关闭三段纵向排布：列表只拿剩下的高度，上下都不被别的块盖住。 */
.hist-list {
  flex: 1 1 0;
  min-height: 0;
  box-sizing: border-box;
  padding-top: 16rpx;
}
.hist-list-end { height: 4rpx; }
.side-rec {
  display: flex;
  align-items: stretch;
  gap: 8rpx;
  margin: 0 16rpx 12rpx;
  padding: 12rpx;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  border-radius: 16rpx;
}
.side-rec.on { border-color: var(--brand); }
.side-main {
  flex: 1;
  min-width: 0;
  display: flex;
  gap: 12rpx;
}
.side-cover {
  width: 88rpx;
  height: 66rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  overflow: hidden;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  display: flex;
  align-items: center;
  justify-content: center;
}
.side-img { width: 100%; height: 100%; }
.side-ph { width: 36rpx; height: 36rpx; }
.side-copy { flex: 1; min-width: 0; }
.side-title {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.3;
  color: var(--text);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.side-pitch {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.35;
  color: var(--text-2);
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.side-state {
  margin-top: 4rpx;
  font-size: 20rpx;
  line-height: 1.3;
  color: var(--text-3);
}
.side-state.doc { color: var(--brand); }
.side-del {
  flex-shrink: 0;
  align-self: center;
  padding: 8rpx 8rpx 8rpx 4rpx;
  font-size: 22rpx;
  color: var(--error);
}
.hist-close {
  flex: 0 0 auto;
  margin: 16rpx 28rpx 0;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: var(--bg-elevated);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  font-size: 28rpx;
}
.consent-mask,
.legal-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  background: var(--overlay);
}
.legal-mask {
  z-index: 50;
  align-items: flex-end;
  padding: 0;
}
.consent-card {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx 32rpx;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
}
.consent-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
}
.consent-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: var(--text-2);
}
.consent-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
}
.box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border-radius: 8rpx;
  border: 1px solid var(--border);
  background: var(--bg-base);
  color: var(--text-on-bright);
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}
.box.on {
  background: var(--choice);
  border-color: var(--choice);
  color: var(--text);
}
.consent-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: var(--text-3);
}
.link { color: var(--text-link); }
.consent-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.consent-actions .btn { flex: 1; }
.btn {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: var(--r-full);
  font-size: 28rpx;
  font-weight: 500;
}
.btn.primary {
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
}
.btn.primary.off {
  background: var(--action-disabled-bg);
  color: var(--action-disabled-fg);
  opacity: 1;
}
.btn.ghost {
  background: var(--action-secondary-bg);
  color: var(--action-secondary-fg);
  border: 1px solid var(--border);
}
.btn.primary:active {
  background: var(--action-primary-pressed);
  color: var(--action-primary-fg);
  transform: scale(var(--press-scale));
}
.btn.ghost:active {
  background: var(--action-secondary-hover);
  transform: scale(var(--press-scale));
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 28rpx 32rpx 40rpx;
  background: var(--bg-base);
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1px solid var(--border-subtle);
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text);
  margin-bottom: 16rpx;
}
.sheet-body {
  max-height: 42vh;
  margin-bottom: 20rpx;
}
.sheet-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-2);
  white-space: pre-wrap;
}
