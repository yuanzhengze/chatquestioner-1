.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #0d0d0d;
  overflow: hidden;
}
.header {
  padding: 12rpx 32rpx 8rpx;
  background: #242424;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
.header-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.header-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 4rpx;
}
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.i-chevron {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #d4ff48;
  border-bottom: 4rpx solid #d4ff48;
  transform: rotate(45deg);
  margin-left: 6rpx;
}
.i-clock {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #d4ff48;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
}
.i-clock-h {
  position: absolute;
  left: 13rpx;
  top: 6rpx;
  width: 4rpx;
  height: 10rpx;
  background: #d4ff48;
  border-radius: 2rpx;
}
.i-clock-m {
  position: absolute;
  left: 13rpx;
  top: 14rpx;
  width: 10rpx;
  height: 4rpx;
  background: #d4ff48;
  border-radius: 2rpx;
}
.header-logo {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 4rpx;
}
.title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.01em;
}
.new-chat {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #d4ff48;
  padding: 8rpx 0 8rpx 8rpx;
}
.stage-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.30);
}
.err {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #f26a6a;
}
.stream-wrap {
  flex: 1 1 auto;
  min-height: 0;
}
.stage {
  flex: 0 0 auto;
  box-sizing: border-box;
  padding: 8rpx 32rpx 16rpx;
}
.stage-panel {
  width: 100%;
}
.options {
  width: 100%;
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.gdd-entry {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 32rpx;
}
.gdd-kicker {
  font-size: 22rpx;
  color: #d4ff48;
  font-weight: 600;
}
.gdd-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}
.gdd-go {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #d4ff48;
}
.avatar-row {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}
.done-bar {
  padding: 20rpx 32rpx 24rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.30);
  font-size: 26rpx;
  background: #0d0d0d;
}
.loading-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
}
.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 56rpx;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 24rpx;
}
.loading-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #333333;
  border-top-color: #d4ff48;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.60);
}
@keyframes spin {
  to { transform: rotate(360deg); }
}

/* 首屏：Forgeax ui-status-audit · 进产品前 */
.gate {
  position: fixed;
  inset: 0;
  z-index: 10;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 16rpx 32rpx 0;
  background: #0d0d0d;
}
.gate-brandrow {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  min-height: 72rpx;
  padding-bottom: 16rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
.gate-mark {
  width: 56rpx;
  height: 56rpx;
  margin-right: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  background: transparent;
  border: none;
}
.gate-mark-logo {
  width: 56rpx;
  height: 56rpx;
}
.gate-brand-copy { min-width: 0; }
.gate-wordmark {
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #ffffff;
}
.gate-kicker {
  margin-top: 2rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: rgba(255, 255, 255, 0.30);
}
.gate-visual {
  flex: 1 1 auto;
  min-height: 0;
  max-height: 36vh;
  margin-top: 24rpx;
  display: flex;
  align-items: stretch;
  justify-content: center;
}
.gate-window {
  width: 100%;
  max-width: 620rpx;
  flex: 1;
  min-height: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 32rpx;
}
.gate-window-bar {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 16rpx;
  background: #242424;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
.gate-window-cap {
  font-size: 20rpx;
  letter-spacing: 0.06em;
  color: rgba(255, 255, 255, 0.30);
}
.gate-window-body {
  flex: 1;
  min-height: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #0d0d0d;
}
.gate-face {
  width: 280rpx;
  height: 280rpx;
  animation: logoIdle 3.2s ease-in-out infinite;
}
@keyframes logoIdle {
  0%, 100% { transform: scale(1); opacity: 1; }
  50% { transform: scale(1.04); opacity: 0.92; }
}
.gate-face-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 120rpx;
  line-height: 1;
}
.gate-copy {
  flex-shrink: 0;
  margin-top: 28rpx;
  padding-top: 24rpx;
  border-top: 1px solid rgba(255, 255, 255, 0.10);
}
.gate-eyebrow {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
  font-size: 20rpx;
  letter-spacing: 0.08em;
  color: rgba(255, 255, 255, 0.30);
}
.gate-eyebrow-bar {
  width: 36rpx;
  height: 4rpx;
  background: #d4ff48;
  flex-shrink: 0;
}
.gate-title {
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.12;
  letter-spacing: -0.03em;
  color: #ffffff;
}
.gate-em { color: #d4ff48; }
.gate-sub {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.60);
}
.gate-actions {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-top: 28rpx;
  flex-shrink: 0;
}
.hist-mask {
  position: fixed;
  inset: 0;
  z-index: 25;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: stretch;
  justify-content: flex-start;
}
.hist-panel {
  width: 78%;
  max-width: 560rpx;
  box-sizing: border-box;
  padding: 48rpx 32rpx 40rpx;
  background: #191919;
  border-right: 1px solid #333333;
  display: flex;
  flex-direction: column;
}
.hist-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 24rpx;
}
.hist-logo {
  width: 56rpx;
  height: 56rpx;
}
.hist-empty {
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.60);
}
.hist-list {
  flex: 1;
  max-height: 70vh;
}
.hist-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 8rpx 20rpx 16rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
  border-radius: 8rpx;
}
.hist-item.on {
  background: rgba(212, 255, 72, 0.10);
  border-left: 3px solid #d4ff48;
}
.hist-main {
  flex: 1;
  min-width: 0;
  padding: 4rpx 8rpx 4rpx 0;
}
.hist-title {
  font-size: 28rpx;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hist-item.on .hist-title { color: #d4ff48; }
.hist-del {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #f26a6a;
}
.hist-item.on .hist-del { color: #f26a6a; }
.hist-close { margin-top: 24rpx; }
.gate-btn {
  margin: 0;
  padding: 0;
  height: 88rpx;
  line-height: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  text-align: center;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
}
.gate-btn::after { border: none; }
.gate-btn.primary {
  background: #d4ff48;
  color: #0d0d0d;
}
.gate-btn.primary.off { opacity: 0.2; }
.gate-btn.ghost {
  background: #191919;
  color: #ffffff;
  border: 1px solid #404040;
}
.gate .gate-btn {
  height: 88rpx;
  line-height: 1;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
}
.gate .gate-btn.primary {
  background: #d4ff48;
  color: #0d0d0d;
  border: none;
  box-shadow: none;
}
.gate .gate-btn.primary.off {
  opacity: 0.2;
}
.gate .gate-btn.ghost {
  background: #191919;
  color: #ffffff;
  border: 1px solid #404040;
}
.gate .gate-press {
  background: #c5ee3a !important;
  color: #0d0d0d !important;
  border-color: #d4ff48 !important;
  transform: scale(0.98);
  opacity: 1;
}
.gate-consent {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 4rpx 0;
}
.gate-box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border-radius: 8rpx;
  border: 1px solid #404040;
  background: #191919;
  color: #0d0d0d;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}
.gate-box.on {
  background: #d4ff48;
  border-color: #d4ff48;
}
.gate-consent-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.30);
}
.gate-link { color: #d4ff48; }
.gate-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.55);
  display: flex;
  align-items: flex-end;
  z-index: 20;
}
.gate-sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 28rpx 32rpx 40rpx;
  background: #191919;
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1px solid #333333;
}
.gate-sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}
.gate-sheet-body {
  max-height: 42vh;
  margin-bottom: 20rpx;
}
.gate-sheet-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.60);
  white-space: pre-wrap;
}
.gate-url {
  margin-top: 16rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #242424;
  border: 1px solid #333333;
  font-size: 22rpx;
  color: #d4ff48;
  word-break: break-all;
}
.gate-sheet-btn { margin-top: 12rpx; }
