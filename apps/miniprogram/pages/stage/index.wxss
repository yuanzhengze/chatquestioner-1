page { height: 100%; background: #0d0d0d; }
.page {
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #0d0d0d;
  overflow: hidden;
}
.header {
  padding: 12rpx 32rpx 8rpx;
  background: #242424;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
.header-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.header-left {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  gap: 4rpx;
}
.icon-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.i-chevron {
  width: 18rpx;
  height: 18rpx;
  border-left: 4rpx solid #d4ff48;
  border-bottom: 4rpx solid #d4ff48;
  transform: rotate(45deg);
  margin-left: 6rpx;
}
.header-logo {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-right: 4rpx;
}
.title {
  flex: 1;
  font-size: 34rpx;
  font-weight: 600;
  color: #ffffff;
  letter-spacing: 0.01em;
}
.new-chat {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #d4ff48;
  padding: 8rpx 0 8rpx 8rpx;
}
.stage-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.30);
}
.err {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #f26a6a;
}
.stream-wrap {
  flex: 1 1 auto;
  min-height: 0;
}
.stage {
  flex: 0 0 auto;
  box-sizing: border-box;
  padding: 8rpx 32rpx 16rpx;
}
.stage-panel {
  width: 100%;
}
.options {
  width: 100%;
  margin-top: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.gdd-entry {
  width: 100%;
  margin-top: 16rpx;
  padding: 24rpx 28rpx;
  box-sizing: border-box;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 32rpx;
}
.gdd-kicker {
  font-size: 22rpx;
  color: #d4ff48;
  font-weight: 600;
}
.gdd-name {
  margin-top: 8rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}
.gdd-go {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #d4ff48;
}
.avatar-row {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}
.done-bar {
  padding: 20rpx 32rpx 24rpx;
  text-align: center;
  color: rgba(255, 255, 255, 0.30);
  font-size: 26rpx;
  background: #0d0d0d;
}
.loading-mask {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.55);
}
.loading-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 56rpx;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 24rpx;
}
.loading-logo {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 16rpx;
}
.spinner {
  width: 56rpx;
  height: 56rpx;
  border: 6rpx solid #333333;
  border-top-color: #d4ff48;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
}
.loading-text {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.60);
}
@keyframes spin {
  to { transform: rotate(360deg); }
}
.i-clock {
  width: 34rpx;
  height: 34rpx;
  border: 4rpx solid #d4ff48;
  border-radius: 50%;
  position: relative;
  box-sizing: border-box;
}
.i-clock-h {
  position: absolute;
  left: 50%;
  top: 6rpx;
  width: 3rpx;
  height: 10rpx;
  margin-left: -1.5rpx;
  background: #d4ff48;
  border-radius: 2rpx;
}
.i-clock-m {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 10rpx;
  height: 3rpx;
  margin-top: -1.5rpx;
  background: #d4ff48;
  border-radius: 2rpx;
}
.hist-mask {
  position: fixed;
  inset: 0;
  z-index: 20;
  background: rgba(0, 0, 0, 0.55);
}
.hist-panel {
  position: absolute;
  left: 0;
  top: 0;
  bottom: 0;
  width: 76%;
  max-width: 560rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  padding: 28rpx 0 32rpx;
  background: #191919;
  border-right: 1px solid #333333;
  animation: histIn 0.28s ease-out;
}
@keyframes histIn {
  from { transform: translateX(-100%); }
  to { transform: translateX(0); }
}
.hist-head {
  padding: 0 28rpx 20rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}
.hist-empty {
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.60);
}
.hist-list {
  flex: 1;
  min-height: 0;
}
.hist-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 16rpx 20rpx 28rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
.hist-item.on {
  background: rgba(212, 255, 72, 0.10);
  border-left: 3px solid #d4ff48;
}
.hist-main {
  flex: 1;
  min-width: 0;
}
.hist-title {
  font-size: 28rpx;
  color: #ffffff;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.hist-item.on .hist-title { color: #d4ff48; }
.hist-del {
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
  color: #f26a6a;
}
.hist-close {
  margin: 20rpx 28rpx 0;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #191919;
  color: #ffffff;
  border: 1px solid #404040;
  border-radius: 16rpx;
  font-size: 28rpx;
}
.consent-mask,
.legal-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 40rpx;
  background: rgba(0, 0, 0, 0.55);
}
.legal-mask {
  z-index: 50;
  align-items: flex-end;
  padding: 0;
}
.consent-card {
  width: 100%;
  box-sizing: border-box;
  padding: 36rpx 32rpx 32rpx;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 24rpx;
}
.consent-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
}
.consent-copy {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.60);
}
.consent-row {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  margin-top: 24rpx;
}
.box {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  margin-top: 4rpx;
  border-radius: 8rpx;
  border: 1px solid #404040;
  background: #191919;
  color: #0d0d0d;
  font-size: 22rpx;
  line-height: 34rpx;
  text-align: center;
}
.box.on {
  background: #d4ff48;
  border-color: #d4ff48;
}
.consent-text {
  flex: 1;
  font-size: 22rpx;
  line-height: 1.5;
  color: rgba(255, 255, 255, 0.30);
}
.link { color: #d4ff48; }
.consent-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}
.consent-actions .btn { flex: 1; }
.btn {
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
}
.btn.primary {
  background: #d4ff48;
  color: #0d0d0d;
}
.btn.primary.off { opacity: 0.2; }
.btn.ghost {
  background: #191919;
  color: #ffffff;
  border: 1px solid #404040;
}
.sheet {
  width: 100%;
  box-sizing: border-box;
  max-height: 76vh;
  padding: 28rpx 32rpx 40rpx;
  background: #191919;
  border-radius: 24rpx 24rpx 0 0;
  border-top: 1px solid #333333;
}
.sheet-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #ffffff;
  margin-bottom: 16rpx;
}
.sheet-body {
  max-height: 42vh;
  margin-bottom: 20rpx;
}
.sheet-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: rgba(255, 255, 255, 0.60);
  white-space: pre-wrap;
}
