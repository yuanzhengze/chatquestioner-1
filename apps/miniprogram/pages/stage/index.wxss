.page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #FAF8F4;
  overflow: hidden;
}
.header {
  padding: 12rpx 32rpx 8rpx;
}
.title {
  font-size: 34rpx;
  font-weight: 700;
  color: #3A3530;
  letter-spacing: 0.01em;
}
.stage-label {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: #8A8175;
}
.err {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #C7564B;
}
.stream-wrap {
  flex: 0 1 auto;
  max-height: 22vh;
  min-height: 80rpx;
  mask-image: linear-gradient(to bottom, transparent 0, #000 24px);
}
.stage {
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 8rpx 32rpx 16rpx;
  background: radial-gradient(60% 50% at 50% 38%, rgba(232, 148, 58, 0.12) 0%, transparent 70%);
}
.options {
  width: 100%;
  margin-top: 16rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.stream-wrap.stream-thin {
  max-height: 16vh;
}
.stage-result {
  justify-content: flex-start;
  align-items: stretch;
  padding-top: 0;
}
.avatar-row {
  display: flex;
  justify-content: center;
  flex-shrink: 0;
}
.done-bar {
  padding: 20rpx 32rpx 24rpx;
  text-align: center;
  color: #8A8175;
  font-size: 26rpx;
  background: #FAF8F4;
}
