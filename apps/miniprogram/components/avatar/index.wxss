.halo {
  position: relative;
  width: 400rpx;
  height: 400rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: width 200ms ease, height 200ms ease;
}
.halo.compact {
  width: 240rpx;
  height: 240rpx;
}
.glow {
  position: absolute;
  inset: -8%;
  border-radius: 50%;
  background: radial-gradient(circle at 50% 45%, rgba(212, 255, 72, 0.18) 0%, transparent 62%);
  z-index: 0;
}
.face {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}
.shadow {
  position: absolute;
  left: 22%;
  right: 22%;
  bottom: 4%;
  height: 7%;
  border-radius: 50%;
  background: radial-gradient(ellipse at center, rgba(0, 0, 0, 0.45) 0%, transparent 70%);
  z-index: 0;
}
