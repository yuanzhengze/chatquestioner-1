.card {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 28rpx;
  border-radius: var(--r-card);
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  animation: popRise var(--dur-smooth) var(--ease-out) both;
  transition: border-color var(--dur-base) var(--ease-out), background var(--dur-base) var(--ease-out);
}
.hover-head { opacity: 0.86; }
.card.open {
  border-color: var(--brand);
  background: var(--brand-tint);
}
.card.chosen {
  border-color: var(--brand);
  background: var(--brand-tint);
}
.card.dismissed { opacity: 0.2; transform: scale(0.98); }
.head { width: 100%; }
.title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.line {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: var(--text);
}
.kicker {
  font-weight: 600;
  letter-spacing: 0.02em;
  color: var(--brand);
}
.card.alt .kicker { color: var(--text-2); }
.sep { color: var(--text-3); font-weight: 500; }
.label { color: var(--text); }
.chevron-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin: -8rpx -12rpx -8rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chevron-hover { opacity: 0.7; }
.chevron {
  width: 14rpx;
  height: 14rpx;
  margin-top: -4rpx;
  border-right: 4rpx solid var(--text-3);
  border-bottom: 4rpx solid var(--text-3);
  transform: rotate(45deg);
  transition: transform var(--dur-panel) var(--ease-out), border-color var(--dur-base) var(--ease-out);
}
.chevron.up {
  margin-top: 4rpx;
  transform: rotate(-135deg);
  border-color: var(--brand);
}
.body {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transform: translateY(-8rpx);
  transition:
    max-height var(--dur-panel) var(--ease-out),
    opacity var(--dur-base) var(--ease-out),
    transform var(--dur-panel) var(--ease-out);
}
.card.open .body {
  max-height: 420rpx;
  opacity: 1;
  transform: translateY(0);
}
.detail {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: var(--text-2);
  white-space: pre-wrap;
}
@keyframes popRise {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
