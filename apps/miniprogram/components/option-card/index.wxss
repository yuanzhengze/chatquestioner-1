.card {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 28rpx;
  border-radius: 24rpx;
  background: #191919;
  border: 1px solid #333333;
  animation: popRise 640ms cubic-bezier(0.22, 0.8, 0.2, 1) both;
  transition: border-color 360ms ease, background 360ms ease;
}
.hover-head { opacity: 0.86; }
.card.open {
  border-color: #d4ff48;
  background: rgba(212, 255, 72, 0.10);
}
.card.chosen {
  border-color: #d4ff48;
  background: rgba(212, 255, 72, 0.10);
}
.card.dismissed { opacity: 0.2; transform: scale(0.98); }
.head { width: 100%; }
.title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.line {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.4;
  color: #ffffff;
}
.kicker {
  font-weight: 600;
  letter-spacing: 0.02em;
  color: #d4ff48;
}
.card.alt .kicker { color: rgba(255, 255, 255, 0.60); }
.sep { color: rgba(255, 255, 255, 0.30); font-weight: 500; }
.label { color: #ffffff; }
.chevron-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin: -8rpx -12rpx -8rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chevron-hover { opacity: 0.7; }
.chevron {
  width: 14rpx;
  height: 14rpx;
  margin-top: -4rpx;
  border-right: 4rpx solid rgba(255, 255, 255, 0.30);
  border-bottom: 4rpx solid rgba(255, 255, 255, 0.30);
  transform: rotate(45deg);
  transition: transform 420ms cubic-bezier(0.22, 0.8, 0.2, 1), border-color 360ms ease;
}
.chevron.up {
  margin-top: 4rpx;
  transform: rotate(-135deg);
  border-color: #d4ff48;
}
.body {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transform: translateY(-8rpx);
  transition:
    max-height 520ms cubic-bezier(0.22, 0.8, 0.2, 1),
    opacity 380ms ease,
    transform 520ms cubic-bezier(0.22, 0.8, 0.2, 1);
}
.card.open .body {
  max-height: 420rpx;
  opacity: 1;
  transform: translateY(0);
}
.detail {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: rgba(255, 255, 255, 0.60);
  white-space: pre-wrap;
}
@keyframes popRise {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
