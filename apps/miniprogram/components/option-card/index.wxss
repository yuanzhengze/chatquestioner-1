.card {
  width: 100%;
  box-sizing: border-box;
  padding: 22rpx 28rpx;
  border-radius: 20px;
  background: #FFFFFF;
  border: 1px solid #ECE6DC;
  box-shadow: 0 2px 6px rgba(74, 59, 42, 0.06), 0 8px 24px rgba(74, 59, 42, 0.08);
  animation: popRise 640ms cubic-bezier(0.22, 0.8, 0.2, 1) both;
  transition: border-color 360ms ease, box-shadow 420ms cubic-bezier(0.22, 0.8, 0.2, 1);
}
.hover-head { opacity: 0.86; }
.card.open {
  border-color: #E8943A;
  box-shadow: 0 2px 6px rgba(74, 59, 42, 0.06), 0 10px 28px rgba(232, 148, 58, 0.16);
}
.card.chosen {
  border-color: #E8943A;
  box-shadow: 0 2px 6px rgba(74, 59, 42, 0.06), 0 8px 24px rgba(74, 59, 42, 0.08), 0 0 0 3px rgba(232, 148, 58, 0.18);
}
.card.dismissed { opacity: 0.35; transform: scale(0.98); }
.head { width: 100%; }
.title-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.line {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.4;
  color: #3A3530;
}
.kicker {
  font-weight: 700;
  letter-spacing: 0.02em;
  color: #5B8A8A;
}
.card.alt .kicker { color: #C77B6B; }
.sep { color: #C9C0B4; font-weight: 500; }
.label { color: #3A3530; }
.chevron-btn {
  flex-shrink: 0;
  width: 64rpx;
  height: 64rpx;
  margin: -8rpx -12rpx -8rpx 0;
  display: flex;
  align-items: center;
  justify-content: center;
}
.chevron-hover { opacity: 0.7; }
.chevron {
  width: 14rpx;
  height: 14rpx;
  margin-top: -4rpx;
  border-right: 4rpx solid #C9C0B4;
  border-bottom: 4rpx solid #C9C0B4;
  transform: rotate(45deg);
  transition: transform 420ms cubic-bezier(0.22, 0.8, 0.2, 1), border-color 360ms ease;
}
.chevron.up {
  margin-top: 4rpx;
  transform: rotate(-135deg);
  border-color: #E8943A;
}
.body {
  max-height: 0;
  opacity: 0;
  overflow: hidden;
  transform: translateY(-8rpx);
  transition:
    max-height 520ms cubic-bezier(0.22, 0.8, 0.2, 1),
    opacity 380ms ease,
    transform 520ms cubic-bezier(0.22, 0.8, 0.2, 1);
}
.card.open .body {
  max-height: 420rpx;
  opacity: 1;
  transform: translateY(0);
}
.detail {
  margin-top: 16rpx;
  font-size: 28rpx;
  line-height: 1.55;
  color: #3A3530;
  white-space: pre-wrap;
}
@keyframes popRise {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: translateY(0); }
}
