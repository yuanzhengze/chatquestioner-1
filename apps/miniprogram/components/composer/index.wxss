.bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 32rpx 24rpx;
  background: #191919;
  border-top: 1px solid rgba(255, 255, 255, 0.10);
}
.input {
  flex: 1;
  min-height: 72rpx;
  max-height: 200rpx;
  background: #242424;
  color: #ffffff;
  border: 1px solid #404040;
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
}
.input.on {
  border-color: #d4ff48;
}
.ph { color: rgba(255, 255, 255, 0.30); }
.send {
  flex-shrink: 0;
  margin: 0;
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 36rpx;
  background: #d4ff48;
  color: #0d0d0d;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
}
.send.off { opacity: 0.2; }
.send::after { border: none; }
