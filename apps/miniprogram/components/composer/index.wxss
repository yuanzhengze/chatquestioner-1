.bar {
  display: flex;
  align-items: flex-end;
  gap: 16rpx;
  padding: 16rpx 32rpx 24rpx;
  background: var(--bg-base);
  border-top: 1px solid var(--divider);
}
.input {
  flex: 1;
  min-width: 0;
  min-height: 72rpx;
  max-height: 200rpx;
  background: var(--bg-elevated);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 16rpx;
  padding: 18rpx 24rpx;
  font-size: 30rpx;
  line-height: 1.5;
}
.input.on {
  border-color: var(--brand);
}
.ph { color: var(--text-3); }
.send {
  flex-shrink: 0;
  width: 72rpx;
  height: 72rpx;
  margin-bottom: 2rpx;
  border-radius: 50%;
  background: var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
}
.send.off { opacity: 0.22; }
.send-press {
  background: var(--brand-hover);
  transform: scale(var(--press-scale));
}
.send-arrow {
  width: 0;
  height: 0;
  border-left: 12rpx solid transparent;
  border-right: 12rpx solid transparent;
  border-bottom: 18rpx solid var(--text-on-bright);
  margin-top: -4rpx;
}
.send-spin {
  width: 28rpx;
  height: 28rpx;
  border: 4rpx solid var(--text-on-bright-3);
  border-top-color: var(--text-on-bright);
  border-radius: 50%;
  animation: sendSpin 0.7s linear infinite;
}
@keyframes sendSpin {
  to { transform: rotate(360deg); }
}
