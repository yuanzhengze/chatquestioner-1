/**
 * 输入条：一个圆角框，文字在左，发送按钮在框内右侧。
 * 单行：框高 = 6px 上下内边距 + 34px 按钮 + 2px 边框 = 48px，文字 22px 行高居中。
 * 多行：文字区从 22px 长到 110px（五行），再多在框里滚；按钮贴底，和最后一行对齐。
 */
.bar {
  padding: 10px 12px 12px;
  background: var(--bg-base);
  border-top: 1px solid var(--divider);
}
.field {
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  min-height: 48px;
  padding: 6px 6px 6px 16px;
  background: var(--bg-elevated);
  border: 1px solid var(--border);
  border-radius: 24px;
}
.field.on { border-color: var(--border-focus); }
.input {
  flex: 1;
  min-width: 0;
  box-sizing: content-box;
  height: 22px;
  margin: 0 8px 6px 0;
  padding: 0;
  background: transparent;
  color: var(--text);
  font-size: 15px;
  font-weight: 400;
  line-height: 22px;
}
.input.locked {
  height: 22px;
  line-height: 22px;
  color: var(--text-3);
}
.ph {
  color: var(--text-3);
  font-size: 15px;
  line-height: 22px;
}
.send {
  flex: 0 0 34px;
  width: 34px;
  height: 34px;
  border-radius: 50%;
  background: var(--action-primary-bg);
  color: var(--action-primary-fg);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background-color var(--dur-fast) var(--ease-out), transform var(--dur-fast) var(--ease-out);
}
.send.off {
  background: var(--action-disabled-bg);
  color: var(--text-3);
}
.send-press {
  background: var(--action-primary-pressed);
  transform: scale(var(--press-scale));
}
/** 向上箭头：一根竖线加一个折角，颜色跟按钮字色走。可见范围约 1.3–15px，几何中心落在 14×16 盒子的中心。 */
.send-up {
  position: relative;
  width: 14px;
  height: 16px;
}
.send-up::before {
  content: "";
  position: absolute;
  left: 6px;
  top: 3px;
  width: 2px;
  height: 12px;
  border-radius: 1px;
  background: currentColor;
}
.send-up::after {
  content: "";
  position: absolute;
  left: 3px;
  top: 3px;
  width: 8px;
  height: 8px;
  box-sizing: border-box;
  border-left: 2px solid currentColor;
  border-top: 2px solid currentColor;
  border-radius: 1px 0 0 0;
  transform: rotate(45deg);
  transform-origin: 50% 50%;
}
.send-spin {
  width: 14px;
  height: 14px;
  border: 2px solid var(--text-on-bright-3);
  border-top-color: var(--action-primary-fg);
  border-radius: 50%;
  animation: sendSpin 0.7s linear infinite;
}
@keyframes sendSpin {
  to { transform: rotate(360deg); }
}
