<view class="bar" style="padding-bottom: {{padBottom}}px;">
  <view class="field {{focused ? 'on' : ''}}">
    <view wx:if="{{busy}}" class="input locked">{{mode === 'gdd' ? '游戏文档生成中...' : '思考中...'}}</view>
    <textarea
      wx:else
      class="input"
      style="height: {{inputH}}px;"
      value="{{value}}"
      placeholder="说说你的脑洞…"
      placeholder-class="ph"
      placeholder-style="color:#A0A0A2;font-size:15px;line-height:22px;"
      maxlength="2000"
      disable-default-padding
      show-confirm-bar="{{false}}"
      adjust-position="{{false}}"
      cursor-spacing="12"
      confirm-type="send"
      confirm-hold="{{false}}"
      bindinput="onInput"
      bindlinechange="onLine"
      bindfocus="onFocus"
      bindblur="onBlur"
      bindconfirm="onConfirm"
    />
    <view
      class="send {{disabled || busy || !value ? 'off' : ''}}"
      hover-class="{{disabled || busy || !value ? 'none' : 'send-press'}}"
      hover-stay-time="80"
      bindtap="onSend"
      aria-role="button"
      aria-label="发送"
    >
      <view wx:if="{{busy}}" class="send-spin"></view>
      <view wx:else class="send-up"></view>
    </view>
  </view>
</view>
