<view class="bar" style="padding-bottom: {{padBottom}}px;">
  <textarea
    class="input {{focused ? 'on' : ''}}"
    value="{{value}}"
    placeholder="说说你的脑洞…"
    placeholder-class="ph"
    placeholder-style="color:#A0A0A2"
    maxlength="2000"
    auto-height
    disable-default-padding
    adjust-position="{{false}}"
    confirm-type="send"
    confirm-hold="{{false}}"
    bindinput="onInput"
    bindfocus="onFocus"
    bindblur="onBlur"
    bindconfirm="onConfirm"
  />
  <view
    class="send {{disabled || busy || !value ? 'off' : ''}}"
    hover-class="{{disabled || busy || !value ? 'none' : 'send-press'}}"
    bindtap="onSend"
    aria-role="button"
    aria-label="发送"
  >
    <view wx:if="{{busy}}" class="send-spin"></view>
    <view wx:else class="send-arrow"></view>
  </view>
</view>
