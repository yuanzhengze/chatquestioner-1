.panel {
  width: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: #191919;
  border: 1px solid #333333;
  border-radius: 24rpx;
  overflow: hidden;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 1px solid rgba(255, 255, 255, 0.10);
}
.title {
  font-size: 26rpx;
  font-weight: 600;
  color: #d4ff48;
}
.copy {
  font-size: 22rpx;
  color: #d4ff48;
  padding: 6rpx 16rpx;
  border: 1px solid #d4ff48;
  border-radius: 16rpx;
}
.body {
  flex: 1;
  min-height: 0;
  padding: 20rpx 28rpx 28rpx;
  box-sizing: border-box;
}
.empty {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.60);
}
