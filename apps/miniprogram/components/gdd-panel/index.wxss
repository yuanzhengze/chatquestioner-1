.panel {
  width: 100%;
  flex: 1;
  min-height: 0;
  display: flex;
  flex-direction: column;
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  border-radius: 24rpx;
  overflow: hidden;
}
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 28rpx;
  border-bottom: 1px solid var(--divider);
}
.title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--brand);
}
.copy {
  font-size: 22rpx;
  color: var(--brand);
  padding: 6rpx 16rpx;
  background: var(--brand-tint);
  border: 1px solid var(--brand-stroke);
  border-radius: 12rpx;
}
.body {
  flex: 1;
  min-height: 0;
  padding: 20rpx 28rpx 28rpx;
  box-sizing: border-box;
}
.empty {
  font-size: 26rpx;
  color: var(--text-2);
}
