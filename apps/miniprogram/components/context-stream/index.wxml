<scroll-view
  class="stream"
  scroll-y
  scroll-top="{{scrollTop}}"
  scroll-with-animation="{{scrollAnim}}"
>
  <block wx:for="{{items}}" wx:key="key">
    <view
      wx:if="{{item.user}}"
      id="{{item.slot ? 'user-slot' : ''}}"
      class="bubble user {{item.ghost ? 'ghost' : ''}}"
    >
      <view class="text">{{item.text}}</view>
    </view>

    <view wx:else class="bubble assistant {{item.dim ? 'dim' : ''}} {{item.appear ? 'appear' : ''}} {{item.dots ? 'thinking' : ''}}">
      <view class="role">NewBee</view>
      <rich-text wx:if="{{item.html}}" nodes="{{item.html}}"></rich-text>
      <block wx:else>
        <rich-text wx:if="{{item.leadHtml}}" nodes="{{item.leadHtml}}"></rich-text>
        <view wx:if="{{item.question}}" class="qbox">{{item.question}}</view>
        <rich-text wx:if="{{item.tailHtml}}" nodes="{{item.tailHtml}}"></rich-text>
        <view wx:if="{{item.dots}}" class="text">…</view>
      </block>
    </view>

    <!--
      三选：紧跟这句问话的第二段气泡。它排在后来插入的用户气泡前面，
      所以收掉它的高度是让上面的对话往下走，刚落地的气泡不动。
    -->
    <view
      wx:if="{{item.owns && opts.length}}"
      id="opts-box"
      class="opts {{optsFreeze >= 0 ? 'frozen' : ''}}"
      style="{{optsFreeze >= 0 ? 'height:' + optsFreeze + 'px;' : ''}}"
    >
      <view
        wx:for="{{opts}}"
        wx:for-item="opt"
        wx:key="id"
        id="opt-{{opt.id}}"
        class="opt {{optsPending === opt.id ? 'taken' : (optsPending ? 'dropped' : '')}}"
        hover-class="{{optsLive ? 'opt-press' : 'none'}}"
        hover-stay-time="80"
        data-id="{{opt.id}}"
        bindtap="onPick"
      >
        <view class="opt-label">{{opt.label}}</view>
        <view wx:if="{{opt.detail && opt.detail !== opt.label}}" class="opt-detail">{{opt.detail}}</view>
      </view>
    </view>
  </block>

  <!-- 量高用：脱离文档流，只为算出插进来的两条气泡有多高。 -->
  <view wx:if="{{probeText}}" id="probe-wrap" class="probe">
    <view class="bubble user">
      <view class="text">{{probeText}}</view>
    </view>
    <view class="bubble assistant thinking">
      <view class="role">NewBee</view>
      <view class="text">…</view>
    </view>
  </view>

  <view id="stream-end" class="end"></view>
</scroll-view>
