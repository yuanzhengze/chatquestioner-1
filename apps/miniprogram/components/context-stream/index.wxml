<scroll-view
  class="stream"
  scroll-y
  scroll-top="{{scrollTop}}"
  scroll-with-animation="{{scrollAnim}}"
>
  <block wx:for="{{items}}" wx:key="key">
    <view wx:if="{{item.user}}" class="row me">
      <view
        id="{{item.slot ? 'user-slot' : ''}}"
        class="bubble me {{item.ghost ? 'ghost' : ''}}"
      >
        <view class="text">{{item.text}}</view>
      </view>
    </view>

    <view wx:else class="row ai {{item.dim ? 'dim' : ''}} {{item.appear ? 'appear' : ''}} {{item.dots ? 'thinking' : ''}}">
      <view class="ava">
        <image wx:if="{{avatar}}" class="ava-img" src="{{avatar}}" mode="aspectFit" />
      </view>
      <view class="bubble ai {{item.dots ? 'dots' : ''}}">
        <rich-text wx:if="{{item.html}}" nodes="{{item.html}}"></rich-text>
        <block wx:else>
          <rich-text wx:if="{{item.leadHtml}}" nodes="{{item.leadHtml}}"></rich-text>
          <view wx:if="{{item.question}}" class="qbox {{item.leadHtml ? 'after' : ''}}">{{item.question}}</view>
          <rich-text wx:if="{{item.tailHtml}}" class="tail" nodes="{{item.tailHtml}}"></rich-text>
          <view wx:if="{{item.dots}}" class="text">…</view>
        </block>
      </view>
    </view>

    <!--
      三选排在用户气泡前面。收掉它的高度和滚动是同一段：
      新气泡已在屏幕里就停住；会落到屏幕外，就在飞行里把它带进来。
    -->
    <view
      wx:if="{{item.owns && opts.length}}"
      id="opts-box"
        class="opts {{optsFreeze >= 0 ? 'frozen' : ''}} {{optsEase ? 'ease' : ''}} {{optsGone ? 'gone' : ''}}"
      style="{{optsFreeze >= 0 ? 'height:' + optsFreeze + 'px;' : ''}}"
    >
      <view
        wx:for="{{opts}}"
        wx:for-item="opt"
        wx:key="id"
        id="opt-{{opt.id}}"
        class="opt {{optsPending === opt.id ? 'taken' : (optsPending ? 'dropped' : '')}}"
        hover-class="{{optsLive ? 'opt-press' : 'none'}}"
        hover-stay-time="80"
        data-id="{{opt.id}}"
        bindtap="onPick"
      >
        <view class="opt-label">{{opt.label}}</view>
        <view wx:if="{{opt.detail && opt.detail !== opt.label}}" class="opt-detail">{{opt.detail}}</view>
      </view>
    </view>
  </block>

  <!-- 量高用：脱离文档流，只为算出插进来的两条气泡有多高。 -->
  <view wx:if="{{probeText}}" id="probe-wrap" class="probe">
    <view class="row me">
      <view class="bubble me">
        <view class="text">{{probeText}}</view>
      </view>
    </view>
    <view class="row ai thinking">
      <view class="ava"></view>
      <view class="bubble ai dots">
        <view class="text">…</view>
      </view>
    </view>
  </view>

  <view id="stream-end" class="end"></view>
</scroll-view>
