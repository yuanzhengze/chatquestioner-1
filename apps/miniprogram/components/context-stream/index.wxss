.stream {
  height: 100%;
  box-sizing: border-box;
  padding: 8rpx 32rpx 16rpx;
}
.bubble {
  max-width: 78%;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
.role {
  font-size: 20rpx;
  letter-spacing: 0.04em;
  margin-bottom: 6rpx;
  color: rgba(255, 255, 255, 0.30);
}
.bubble.user {
  margin-left: auto;
  background: #d4ff48;
  color: #0d0d0d;
  white-space: pre-wrap;
}
.bubble.user .role { color: #0d0d0d; }
.bubble.assistant {
  background: #191919;
  border: 1px solid #333333;
  color: #ffffff;
}
.md {
  display: block;
  width: 100%;
}
.end { height: 4rpx; }
