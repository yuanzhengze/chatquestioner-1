.stream {
  height: 100%;
  box-sizing: border-box;
  padding: 8rpx 32rpx 16rpx;
}
.bubble {
  max-width: 78%;
  padding: 12rpx 20rpx;
  border-radius: 16rpx;
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
.role {
  font-size: 20rpx;
  letter-spacing: 0.04em;
  margin-bottom: 6rpx;
  color: var(--text-3);
}
.bubble.user {
  margin-left: auto;
  background: var(--brand);
  color: var(--text-on-bright);
  white-space: pre-wrap;
}
.bubble.user .role { color: var(--text-on-bright); }
.bubble.assistant {
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  color: var(--text);
}
.md {
  display: block;
  width: 100%;
}
.end { height: 4rpx; }
