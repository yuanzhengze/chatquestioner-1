/**
 * 聊天版式只有一套规则，两边共用：
 * - 左右各留 24rpx 页边。
 * - 助手：64rpx 头像 + 16rpx 间距 + 气泡；气泡最宽到整行减去头像和右侧 48rpx 留空。
 * - 用户：靠右；左侧留出 128rpx（头像位 + 间距 + 48rpx），所以两边外缘天然错开，助手长文仍然够宽。
 * - 气泡：15px / 22px / 400，内边距 10px 14px，圆角 18px，1px 边框（用户透明）。两边只换底色和字色。
 */
.stream {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  padding: 8rpx 24rpx 16rpx;
}
.row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}
.row.me { justify-content: flex-end; }
.ava {
  flex: 0 0 64rpx;
  width: 64rpx;
  height: 64rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  overflow: hidden;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ava-img { width: 40rpx; height: 40rpx; }
.bubble {
  box-sizing: border-box;
  min-width: 0;
  padding: 10px 14px;
  border: 1px solid transparent;
  border-radius: 18px;
  font-size: 15px;
  font-weight: 400;
  line-height: 22px;
  word-break: break-word;
  overflow-wrap: anywhere;
}
.bubble.me {
  max-width: calc(100% - 128rpx);
  background: var(--brand);
  color: var(--text-on-bright);
}
.bubble.ai {
  max-width: calc(100% - 128rpx);
  background: var(--bg-base);
  border-color: var(--border-subtle);
  color: var(--text);
}
.text { white-space: pre-wrap; }
.bubble rich-text { display: block; }
/** 变形飞行期间先占位不显形，落点因此是真实的。 */
.bubble.ghost {
  opacity: 0;
  pointer-events: none;
}
/** 高度已经占住、还不该看见：「…」等变形落地了再显形。 */
.row.dim {
  opacity: 0;
}
.row.appear {
  animation: bubbleIn var(--dur-panel) var(--ease-out) both;
}
/** 思考中的点从下往上滑入，和选项出现是同一种语言，不是单纯淡出淡入。 */
.row.thinking.appear {
  animation: thinkIn var(--dur-panel) var(--ease-out) both;
}
@keyframes thinkIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: none; }
}
@keyframes bubbleIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.md {
  display: block;
  width: 100%;
}
/** 问方向的那一句单独衬底，一眼看到在问什么。字号行高跟气泡正文一致。 */
.qbox {
  padding: 8px 10px;
  border-radius: 10px;
  background: var(--brand-tint);
  border: 1px solid var(--brand-stroke);
  color: var(--text);
  font-size: 15px;
  line-height: 22px;
}
.qbox.after { margin-top: 6px; }
.tail { margin-top: 6px; }
/** 三选挂在助手气泡下面，左缘和气泡对齐，宽度规则和助手气泡相同。 */
.opts {
  box-sizing: border-box;
  margin-left: 80rpx;
  max-width: calc(100% - 128rpx);
  margin-bottom: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
/**
 * 收起时高度和滚动用同一段 --dur-fly / --ease-out。
 * 两条一起走。尾巴已经在屏幕里时气泡停住；尾巴在屏幕外时，同一段把滚动加进去。
 * ease 类先挂上，下一帧才收高度和下边距，避免微信不播过渡、高度瞬间塌掉。
 */
.opts.frozen {
  overflow: hidden;
}
.opts.frozen.ease {
  transition: height var(--dur-fly) var(--ease-out), margin-bottom var(--dur-fly) var(--ease-out);
}
.opts.frozen.gone {
  margin-bottom: 0;
}
/** 这四项要和 pages/stage 的 .chip.from-opt 完全一致，否则接手那一帧会跳。 */
.opt {
  box-sizing: border-box;
  /** 块被压矮时卡片不许跟着缩，要原样溢出显示。 */
  flex: 0 0 auto;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  transition:
    opacity var(--dur-fast) var(--ease-out),
    transform var(--dur-fast) var(--ease-out);
}
.opt-press {
  background: var(--hover);
  transform: scale(0.98);
}
/** 被选中的那张交给固定层演，原地必须立刻让位，不能有交叉淡化。 */
.opt.taken {
  opacity: 0;
  transition: none;
  pointer-events: none;
}
.opt.dropped {
  opacity: 0;
  transform: translateY(6rpx);
  pointer-events: none;
}
.opt-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}
.opt-detail {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
}
.probe {
  position: absolute;
  left: 24rpx;
  right: 24rpx;
  top: 0;
  overflow: hidden;
  visibility: hidden;
  pointer-events: none;
}
.end { height: 4rpx; }
