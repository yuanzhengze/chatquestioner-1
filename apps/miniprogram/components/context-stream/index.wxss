.stream {
  position: relative;
  height: 100%;
  box-sizing: border-box;
  padding: 8rpx 32rpx 16rpx;
}
.bubble {
  box-sizing: border-box;
  max-width: 78%;
  padding: 12rpx 20rpx;
  border-radius: var(--r-ctrl);
  margin-bottom: 12rpx;
  font-size: 26rpx;
  line-height: 1.5;
}
.role {
  font-size: 20rpx;
  letter-spacing: 0.04em;
  margin-bottom: 6rpx;
  color: var(--text-3);
}
.bubble.user {
  margin-left: auto;
  background: var(--brand);
  color: var(--text-on-bright);
  white-space: pre-wrap;
}
.bubble.user .role { color: var(--text-on-bright); }
/** 变形飞行期间先占位不显形，落点因此是真实的。 */
.bubble.user.ghost {
  opacity: 0;
  pointer-events: none;
}
.bubble.assistant {
  background: var(--bg-base);
  border: 1px solid var(--border-subtle);
  color: var(--text);
}
/** 高度已经占住、还不该看见：「…」等变形落地了再显形。 */
.bubble.assistant.dim {
  opacity: 0;
}
.bubble.appear {
  animation: bubbleIn var(--dur-panel) var(--ease-out) both;
}
/** 思考中的点从下往上滑入，和选项出现是同一种语言，不是单纯淡出淡入。 */
.bubble.thinking.appear {
  animation: thinkIn var(--dur-panel) var(--ease-out) both;
}
@keyframes thinkIn {
  from { opacity: 0; transform: translateY(12rpx); }
  to { opacity: 1; transform: none; }
}
/** 还没出字时只留一粒点，不要拉成和正式回复一样宽。 */
.bubble.thinking {
  width: fit-content;
  max-width: 40%;
  padding: 8rpx 16rpx;
}
@keyframes bubbleIn {
  from { opacity: 0; }
  to { opacity: 1; }
}
.md {
  display: block;
  width: 100%;
}
/** 问方向的那一句单独衬底，一眼看到在问什么。 */
.qbox {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: var(--brand-tint);
  border: 1px solid var(--brand-stroke);
  color: var(--text);
  line-height: 1.55;
}
.opts {
  box-sizing: border-box;
  max-width: 86%;
  margin-bottom: 12rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
/**
 * 收起时高度和滚动用同一段 --dur-fly / --ease-out。
 * 两条一起走。尾巴已经在屏幕里时气泡停住；尾巴在屏幕外时，同一段把滚动加进去。
 * ease 类先挂上，下一帧才收高度和下边距，避免微信不播过渡、高度瞬间塌掉。
 */
.opts.frozen {
  overflow: hidden;
}
.opts.frozen.ease {
  transition: height var(--dur-fly) var(--ease-out), margin-bottom var(--dur-fly) var(--ease-out);
}
.opts.frozen.gone {
  margin-bottom: 0;
}
/** 这四项要和 pages/stage 的 .chip.from-opt 完全一致，否则接手那一帧会跳。 */
.opt {
  box-sizing: border-box;
  /** 块被压矮时卡片不许跟着缩，要原样溢出显示。 */
  flex: 0 0 auto;
  padding: 16rpx 18rpx;
  border-radius: 12rpx;
  background: var(--bg-elevated);
  border: 1px solid var(--border-subtle);
  transition:
    opacity var(--dur-fast) var(--ease-out),
    transform var(--dur-fast) var(--ease-out);
}
.opt-press {
  background: var(--hover);
  transform: scale(0.98);
}
/** 被选中的那张交给固定层演，原地必须立刻让位，不能有交叉淡化。 */
.opt.taken {
  opacity: 0;
  transition: none;
  pointer-events: none;
}
.opt.dropped {
  opacity: 0;
  transform: translateY(6rpx);
  pointer-events: none;
}
.opt-label {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
  line-height: 1.4;
}
.opt-detail {
  margin-top: 8rpx;
  font-size: 24rpx;
  line-height: 1.5;
  color: var(--text-2);
}
.probe {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 0;
  overflow: hidden;
  visibility: hidden;
  pointer-events: none;
}
.end { height: 4rpx; }
