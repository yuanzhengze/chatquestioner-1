page {
  --bg-canvas: #0d0d0d;
  --bg-panel: #191919;
  --bg-elevated: #242424;
  --bg-float: #333333;
  --text: #ffffff;
  --text-2: rgba(255, 255, 255, 0.60);
  --text-3: rgba(255, 255, 255, 0.30);
  --border: #333333;
  --border-2: #404040;
  --divider: rgba(255, 255, 255, 0.10);
  --brand: #d4ff48;
  --brand-soft: rgba(212, 255, 72, 0.10);
  --error: #f26a6a;
  --warning: #ffb056;
  --r-tag: 8rpx;
  --r-ctrl: 16rpx;
  --r-panel: 24rpx;
  --r-card: 32rpx;
  background: #0d0d0d;
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.55;
}

.muted { color: rgba(255, 255, 255, 0.60); }
.err { color: #f26a6a; }
