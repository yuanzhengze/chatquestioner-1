{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@cq/modules": ["../../packages/modules/src/index.ts"],
      "@cq/module-index": ["../../packages/module-index/src/index.ts"],
      "@cq/orchestrator": ["../../packages/orchestrator/src/index.ts"]
    }
  },
  "include": ["src"]
}
