{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cq/gdd": ["packages/gdd/src/index.ts"],
      "@cq/conversation": ["packages/conversation/src/index.ts"],
      "@cq/avatar": ["packages/avatar/src/index.ts"],
      "@cq/knowledge": ["packages/knowledge/src/index.ts"],
      "@cq/store": ["packages/store/src/index.ts"]
    }
  },
  "include": [
    "packages/gdd/src",
    "packages/conversation/src",
    "packages/avatar/src",
    "packages/avatar/scripts",
    "packages/knowledge/src",
    "packages/knowledge/scripts",
    "packages/store/src",
    "apps/server/src"
  ]
}
