{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@cq/dsl": ["packages/dsl/src/index.ts"],
      "@cq/gdd": ["packages/gdd/src/index.ts"],
      "@cq/resolver": ["packages/resolver/src/index.ts"],
      "@cq/conversation": ["packages/conversation/src/index.ts"],
      "@cq/avatar": ["packages/avatar/src/index.ts"],
      "@cq/modules": ["packages/modules/src/index.ts"],
      "@cq/module-index": ["packages/module-index/src/index.ts"],
      "@cq/orchestrator": ["packages/orchestrator/src/index.ts"],
      "@cq/rhythm": ["packages/rhythm/src/index.ts"]
    }
  },
  "include": [
    "packages/dsl/src",
    "packages/dsl/scripts",
    "packages/gdd/src",
    "packages/resolver/src",
    "packages/resolver/scripts",
    "packages/conversation/src",
    "packages/avatar/src",
    "packages/avatar/scripts",
    "packages/modules/src",
    "packages/module-index/src",
    "packages/orchestrator/src",
    "packages/rhythm/src",
    "apps/server/src"
  ]
}
